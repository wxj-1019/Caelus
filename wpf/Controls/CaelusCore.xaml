<UserControl x:Class="CaelusApp.WpfHost.Controls.CaelusCore"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="100" Height="100" IsHitTestVisible="False">
  <Grid>
    <!-- 外虚线环 + 顶点 Accent 亮点（极简 Linear：静态几何，无辉光无旋转） -->
    <Grid x:Name="RingOuter">
      <Ellipse Width="86" Height="86" Stroke="{DynamicResource BorderStrongBrush}"
               StrokeThickness="1" StrokeDashArray="3 7"/>
      <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentPrimaryBrush}"
               VerticalAlignment="Top" Margin="0,6,0,0"/>
    </Grid>

    <!-- 中双弧环（反转 22s）：渐变弧 + 180° 相位 AccentEdge 弧 -->
    <Grid x:Name="RingMid">
      <Ellipse Width="70" Height="70" StrokeThickness="3" StrokeDashArray="72 217" StrokeDashCap="Round">
        <Ellipse.Stroke>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentPrimaryColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentSecondaryColor}" Offset="1"/>
          </LinearGradientBrush>
        </Ellipse.Stroke>
      </Ellipse>
      <Ellipse Width="70" Height="70" Stroke="{DynamicResource AccentEdgeBrush}"
               StrokeThickness="3" StrokeDashArray="72 217" StrokeDashCap="Round"
               RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
          <RotateTransform Angle="180"/>
        </Ellipse.RenderTransform>
      </Ellipse>
    </Grid>

    <!-- 内刻度环（静止） -->
    <Ellipse Width="54" Height="54" Stroke="{DynamicResource BorderSubtleBrush}"
             StrokeThickness="3" StrokeDashArray="2 4"/>

    <!-- 中心盘 -->
    <Ellipse Width="46" Height="46" Fill="{DynamicResource Surface1Brush}"
             Stroke="{DynamicResource AccentEdgeBrush}" StrokeThickness="1"/>

    <!-- 闪电 + 模式名 -->
    <StackPanel x:Name="CoreIdentity"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
      <Path Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"
            Fill="{DynamicResource AccentPrimaryBrush}" Data="{DynamicResource IconBolt}"/>
      <TextBlock x:Name="ModeLabel" Text="常规" FontSize="8" Margin="0,2,0,0"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
  </Grid>
</UserControl>
