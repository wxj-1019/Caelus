<Window x:Class="CaelusApp.WpfHost.Dialogs.AddGameDialogWpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="添加游戏" Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource FontUi}"
        ResizeMode="CanResize" MinWidth="500" MinHeight="400">
  <DockPanel Margin="16">
    <!-- 底部按钮 -->
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="BtnBrowse" Content="浏览…" Click="OnBrowse" Padding="12,6" Margin="0,0,8,0"/>
      <Button Grid.Column="1" x:Name="BtnDeep" Content="深度扫描" Click="OnDeepScan" Padding="12,6" Margin="0,0,8,0"/>
      <TextBlock Grid.Column="2" x:Name="LblInfo" Text="正在扫描…" FontSize="11"
                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
      <Button Grid.Column="3" x:Name="BtnAdd" Content="添加" Click="OnAccept" Padding="16,6" Margin="8,0,0,0"
              IsEnabled="False" Style="{DynamicResource PrimaryButton}"/>
      <Button Grid.Column="4" Content="取消" Click="OnCancel" Padding="12,6" Margin="8,0,0,0"
              Style="{DynamicResource GhostButton}" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>

    <!-- 过滤栏 -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="全选" Click="OnSelectAll" Padding="10,4" Margin="8,0,0,0"/>
      <TextBox x:Name="TbFilter" TextChanged="OnFilterChanged" Padding="6,4"
               Background="{DynamicResource Surface0Brush}"
               BorderBrush="{DynamicResource BorderSubtleBrush}"
               Foreground="{DynamicResource TextPrimaryBrush}"/>
    </DockPanel>

    <!-- 游戏列表 -->
    <ListBox x:Name="LstGames" Background="Transparent" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="OnSelectionChanged"
             MouseDoubleClick="OnItemDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,4" Orientation="Horizontal">
            <CheckBox IsChecked="{Binding Checked}" VerticalAlignment="Center" Margin="0,0,8,0"
                      IsEnabled="{Binding CanCheck}"/>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                <TextBlock Text="{Binding Tag}" FontSize="10" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="{Binding ExePath}" FontSize="10"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
