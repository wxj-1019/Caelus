<Window x:Class="CaelusApp.WpfHost.Dialogs.AddGameDialogWpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="添加游戏" Width="680" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource FontUi}"
        ResizeMode="CanResize" MinWidth="560" MinHeight="460"
        AutomationProperties.Name="添加游戏">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="添加游戏" Style="{DynamicResource PageHeader}"/>
      <TextBlock Text="从安装记录中选择，或手动定位游戏主程序"
                 Style="{DynamicResource PageSubtitle}" Margin="0,4,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Style="{DynamicResource SettingsGroup}" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
          <TextBox x:Name="TbFilter" Style="{DynamicResource InputBox}"
                   TextChanged="OnFilterChanged" Padding="10,7"
                   AutomationProperties.Name="筛选游戏"
                   AutomationProperties.HelpText="按游戏名称或可执行文件路径筛选"/>
          <TextBlock x:Name="FilterHint" Text="搜索名称或路径" Margin="11,0,0,0"
                     VerticalAlignment="Center" IsHitTestVisible="False"
                     FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
        </Grid>
        <Button Grid.Column="1" x:Name="BtnSelectAll" Content="全选" Click="OnSelectAll"
                Style="{DynamicResource GhostButton}" Padding="12,7" Margin="10,0,0,0"
                AutomationProperties.Name="全选或取消全选当前游戏"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{DynamicResource SettingsGroup}" Padding="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10,8,10,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="扫描结果" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ProgressBar x:Name="ScanProgress" Width="72" Height="3" Margin="0,0,10,0"
                         IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock Text="空格勾选 · 双击切换 · 回车添加" FontSize="10"
                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <ListBox Grid.Row="1" x:Name="LstGames" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{DynamicResource ListItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnSelectionChanged"
                 PreviewKeyDown="OnListKeyDown"
                 MouseDoubleClick="OnItemDoubleClick"
                 AutomationProperties.Name="可添加的游戏">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,2" MinHeight="52">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding Checked, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="8,0,12,0"
                          IsEnabled="{Binding CanCheck}"
                          Checked="OnRowCheckedChanged" Unchecked="OnRowCheckedChanged"
                          AutomationProperties.Name="选择此游戏"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding ExePath}" FontSize="10" Margin="0,3,0,0"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="2" Margin="12,0,8,0" Padding="8,3"
                        VerticalAlignment="Center" CornerRadius="{DynamicResource RadiusSm}"
                        Background="{DynamicResource GlassNavBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasTag}" Value="False">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Tag}" FontSize="10"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" x:Name="LblInfo" Text="正在扫描…" FontSize="11"
                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                 AutomationProperties.Name="扫描状态"/>
      <Grid Grid.Row="1" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" x:Name="BtnBrowse" Content="浏览文件…" Click="OnBrowse"
                Style="{DynamicResource GhostButton}" Padding="12,7" Margin="0,0,8,0"
                AutomationProperties.Name="浏览游戏主程序"/>
        <Button Grid.Column="1" x:Name="BtnDeep" Content="深度扫描…" Click="OnDeepScan"
                Style="{DynamicResource GhostButton}" Padding="12,7" Margin="0,0,8,0"
                AutomationProperties.Name="选择目录进行深度扫描"/>
        <Button Grid.Column="3" Content="取消" Click="OnCancel" IsCancel="True"
                Style="{DynamicResource GhostButton}" Padding="14,7" Margin="8,0,0,0"
                AutomationProperties.Name="取消添加游戏"/>
        <Button Grid.Column="4" x:Name="BtnAdd" Content="添加" Click="OnAccept"
                Padding="18,7" Margin="8,0,0,0" IsEnabled="False" IsDefault="True"
                Style="{DynamicResource PrimaryButton}"
                AutomationProperties.Name="添加所选游戏"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
