<Window x:Class="CaelusApp.WpfHost.Dialogs.LolAddonDialogWpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="英雄联盟附加层清理" Width="720" Height="590"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinWidth="600" MinHeight="500"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource FontUi}"
        AllowDrop="True" DragEnter="OnDragEnter" Drop="OnDrop"
        PreviewKeyDown="OnWindowKeyDown"
        AutomationProperties.Name="英雄联盟附加层清理">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="英雄联盟附加层清理" Style="{DynamicResource PageHeader}"/>
      <TextBlock Text="检查并删除客户端附加组件，不触碰游戏本体与登录链路"
                 Style="{DynamicResource PageSubtitle}" Margin="0,4,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Style="{DynamicResource SettingsGroup}" Margin="0,0,0,12">
      <Border Style="{DynamicResource SettingsRow}">
        <TextBlock Text="删完后客户端更新可能会重新下载这些组件。英雄联盟、WeGame 或反作弊运行时不会执行删除。"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
      </Border>
    </Border>

    <Border Grid.Row="2" Style="{DynamicResource SettingsGroup}" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" x:Name="TbPath" Style="{DynamicResource InputBox}"
                 VerticalContentAlignment="Center" KeyDown="OnPathKeyDown"
                 AutomationProperties.Name="英雄联盟安装目录"
                 AutomationProperties.HelpText="输入含 Game 和 LeagueClient 的目录，或拖入任意子目录"/>
        <Button Grid.Column="1" x:Name="BtnInspect" Content="检查" Click="OnInspect"
                Style="{DynamicResource PrimaryButton}" Padding="14,7" Margin="10,0,0,0"
                AutomationProperties.Name="检查英雄联盟附加层"/>
        <Button Grid.Column="2" x:Name="BtnBrowse" Content="浏览…" Click="OnBrowse"
                Style="{DynamicResource GhostButton}" Padding="14,7" Margin="8,0,0,0"
                AutomationProperties.Name="浏览英雄联盟安装目录"/>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{DynamicResource StatusBanner}" Margin="0,0,0,12">
      <DockPanel>
        <ProgressBar x:Name="BusyIndicator" DockPanel.Dock="Right" Width="92" Height="4"
                     Margin="12,0,0,0" IsIndeterminate="True" Visibility="Collapsed"
                     AutomationProperties.Name="附加层操作进度"/>
        <TextBlock x:Name="LblStatus" Text="选择英雄联盟安装目录，或把目录拖到窗口中"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                   AutomationProperties.Name="附加层检查状态"/>
      </DockPanel>
    </Border>

    <Border Grid.Row="4" Style="{DynamicResource SettingsGroup}" Padding="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="检查结果" Margin="10,8,10,6"
                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <ListBox Grid.Row="1" x:Name="LstCandidates" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{DynamicResource ListItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="可删除的附加层项目">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{DynamicResource SettingsRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding RelativePath}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding State}" Margin="14,0,4,0"
                             VerticalAlignment="Center" FontSize="11"
                             Foreground="{Binding StateBrush}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="5" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" Content="关闭" Click="OnClose" IsCancel="True"
              Style="{DynamicResource GhostButton}" Padding="16,7" Margin="8,0,0,0"
              AutomationProperties.Name="关闭英雄联盟附加层清理"/>
      <Button Grid.Column="2" x:Name="BtnDelete" Content="删除附加层" Click="OnDelete"
              Style="{DynamicResource DangerButton}" Padding="16,7" Margin="8,0,0,0"
              IsEnabled="False" AutomationProperties.Name="删除检查到的英雄联盟附加层"/>
    </Grid>
  </Grid>
</Window>
