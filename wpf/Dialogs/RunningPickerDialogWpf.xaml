<Window x:Class="CaelusApp.WpfHost.Dialogs.RunningPickerDialogWpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="选运行中的程序" Width="720" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource FontUi}"
        ResizeMode="CanResize" MinWidth="560" MinHeight="440"
        AutomationProperties.Name="选择运行中的程序"
        PreviewKeyDown="OnWindowKeyDown">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="选运行中的程序" Style="{DynamicResource PageHeader}"/>
      <TextBlock Text="只列出你自己开着的、有窗口的程序。系统进程和反作弊不在其中。"
                 Style="{DynamicResource PageSubtitle}" Margin="0,4,0,0"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="1" Style="{DynamicResource SettingsGroup}" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
          <TextBox x:Name="TbFilter" Style="{DynamicResource InputBox}"
                   Padding="10,7" TextChanged="OnFilterChanged"
                   AutomationProperties.Name="筛选运行中的程序"
                   AutomationProperties.HelpText="按程序名称或可执行文件路径筛选"/>
          <TextBlock x:Name="FilterHint" Text="搜索名称或路径" Margin="11,0,0,0"
                     VerticalAlignment="Center" IsHitTestVisible="False"
                     FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
        </Grid>
        <Button Grid.Column="1" x:Name="BtnSelectAll" Content="全选" Click="OnSelectAll"
                Style="{DynamicResource GhostButton}" Padding="12,7" Margin="10,0,0,0"
                IsEnabled="False"
                AutomationProperties.Name="全选或取消全选当前筛选结果"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{DynamicResource SettingsGroup}" Padding="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10,8,10,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="运行中的程序" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Grid.Column="1" Text="空格勾选 · Ctrl+A 全选 · 回车添加" FontSize="{DynamicResource FontSizeXs}"
                     Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
        </Grid>

        <ListBox Grid.Row="1" x:Name="LstPrograms" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{DynamicResource ListItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Single"
                 PreviewKeyDown="OnListKeyDown"
                 MouseDoubleClick="OnItemDoubleClick"
                 AutomationProperties.Name="可加入白名单的运行程序"
                 AutomationProperties.HelpText="使用方向键选择，空格勾选，回车添加">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,2" MinHeight="56">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding Checked, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="8,0,12,0"
                          Checked="OnRowCheckedChanged" Unchecked="OnRowCheckedChanged"
                          AutomationProperties.Name="{Binding Title}"
                          AutomationProperties.HelpText="{Binding Path}"/>
                <Grid Grid.Column="1" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                  <Border CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"
                          BorderBrush="{DynamicResource AccentEdgeBrush}" BorderThickness="1">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ModeAccentBrush}"/>
                  </Border>
                  <Image Source="{Binding Icon}" Stretch="Uniform" SnapsToDevicePixels="True"
                         AutomationProperties.Name="程序图标"/>
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSizeCaption}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Path}" FontSize="{DynamicResource FontSizeXs}" Margin="0,3,0,0"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="{DynamicResource FontSizeXs}"
                           Margin="14,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Right"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" x:Name="LblInfo" Text="正在看有哪些程序开着…"
                 FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                 TextWrapping="Wrap" VerticalAlignment="Center"
                 AutomationProperties.Name="扫描状态"/>
      <Button Grid.Column="1" x:Name="BtnRefresh" Content="刷新" Click="OnRefresh"
              Style="{DynamicResource GhostButton}" Padding="12,7" Margin="12,0,0,0"
              AutomationProperties.Name="刷新运行中的程序"/>
      <Button Grid.Column="2" Content="取消" Click="OnCancel" IsCancel="True"
              Style="{DynamicResource GhostButton}" Padding="14,7" Margin="8,0,0,0"
              AutomationProperties.Name="取消选择运行中的程序"/>
      <Button Grid.Column="3" x:Name="BtnAdd" Content="加入白名单" Click="OnAccept"
              Padding="18,7" Margin="8,0,0,0" IsEnabled="False" IsDefault="True"
              Style="{DynamicResource PrimaryButton}"
              AutomationProperties.Name="把所选程序加入白名单"/>
    </Grid>
  </Grid>
</Window>
