<Window x:Class="CaelusApp.WpfHost.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caelus 启动中" Width="460" Height="340"
        WindowStyle="None" AllowsTransparency="False" Background="#FF1B1524"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, sans-serif">
  <!-- 棉花糖启动屏：样式完全自包含（不引用应用级主题资源）。
       全部动效只碰 RenderTransform / Opacity，交给渲染线程，主线程泵消息时依旧顺滑。 -->
  <Grid x:Name="Root" ClipToBounds="True">

    <!-- 漂浮的极光软糖团：低频呼吸漂移，营造"云层"氛围 -->
    <Ellipse x:Name="BlobA" Width="330" Height="330" Opacity="0.34"
             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-110,-130,0,0">
      <Ellipse.Fill>
        <RadialGradientBrush GradientOrigin="0.5,0.5">
          <GradientStop Color="#668B7CF6" Offset="0"/>
          <GradientStop Color="#008B7CF6" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
      <Ellipse.RenderTransform><TranslateTransform x:Name="BlobAXf"/></Ellipse.RenderTransform>
    </Ellipse>
    <Ellipse x:Name="BlobB" Width="290" Height="290" Opacity="0.30"
             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-90,-100,0">
      <Ellipse.Fill>
        <RadialGradientBrush GradientOrigin="0.5,0.5">
          <GradientStop Color="#5CFF8A5C" Offset="0"/>
          <GradientStop Color="#00FF8A5C" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
      <Ellipse.RenderTransform><TranslateTransform x:Name="BlobBXf"/></Ellipse.RenderTransform>
    </Ellipse>
    <Ellipse x:Name="BlobC" Width="310" Height="310" Opacity="0.26"
             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-150">
      <Ellipse.Fill>
        <RadialGradientBrush GradientOrigin="0.5,0.5">
          <GradientStop Color="#4DE6B84C" Offset="0"/>
          <GradientStop Color="#00E6B84C" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
      <Ellipse.RenderTransform><TranslateTransform x:Name="BlobCXf"/></Ellipse.RenderTransform>
    </Ellipse>

    <!-- 四散的糖果纸屑点点 -->
    <Canvas>
      <Path x:Name="SparkA" Data="M0 -4 L1.1 -1.1 4 0 1.1 1.1 0 4 -1.1 1.1 -4 0 -1.1 -1.1 Z"
            Fill="#E6B84C" Canvas.Left="74" Canvas.Top="64" Opacity="0">
        <Path.RenderTransform><ScaleTransform x:Name="SparkAXf" CenterX="0" CenterY="0"/></Path.RenderTransform>
      </Path>
      <Path x:Name="SparkB" Data="M0 -5 L1.4 -1.4 5 0 1.4 1.4 0 5 -1.4 1.4 -5 0 -1.4 -1.4 Z"
            Fill="#A78BFA" Canvas.Left="392" Canvas.Top="88" Opacity="0">
        <Path.RenderTransform><ScaleTransform x:Name="SparkBXf" CenterX="0" CenterY="0"/></Path.RenderTransform>
      </Path>
      <Path x:Name="SparkC" Data="M0 -3.5 L1 -1 3.5 0 1 1 0 3.5 -1 1 -3.5 0 -1 -1 Z"
            Fill="#FF8A5C" Canvas.Left="112" Canvas.Top="252" Opacity="0">
        <Path.RenderTransform><ScaleTransform x:Name="SparkCXf" CenterX="0" CenterY="0"/></Path.RenderTransform>
      </Path>
      <Ellipse x:Name="SparkD" Width="5" Height="5" Fill="#8B7CF6" Canvas.Left="344" Canvas.Top="236" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform><ScaleTransform x:Name="SparkDXf"/></Ellipse.RenderTransform>
      </Ellipse>
    </Canvas>

    <!-- 主舞台 -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

      <!-- 徽标：三重反向旋转的虚线环 + 呼吸挤压的棉花糖 + 闪电 -->
      <Grid x:Name="LogoStage" Width="104" Height="104" Opacity="0">
        <Grid.RenderTransform><ScaleTransform x:Name="LogoScale" ScaleX="0.3" ScaleY="0.3" CenterX="52" CenterY="52"/></Grid.RenderTransform>

        <Ellipse x:Name="RingOuter" Stroke="#3A3246" StrokeThickness="1.2" StrokeDashArray="3 7" Margin="2"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><RotateTransform x:Name="RingOuterRot"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="RingA" Stroke="#8B7CF6" StrokeThickness="3.5" StrokeDashArray="70 217" StrokeDashCap="Round" Margin="10"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><RotateTransform x:Name="RingARot"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="RingB" Stroke="#A78BFA" StrokeThickness="3.5" StrokeDashArray="70 217" StrokeDashCap="Round" Margin="10"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><RotateTransform x:Name="RingBRot" Angle="180"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="RingInner" Stroke="#3A3246" StrokeThickness="2.5" StrokeDashArray="2 5" Margin="26"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><RotateTransform x:Name="RingInnerRot"/></Ellipse.RenderTransform>
        </Ellipse>

        <!-- 轨道糖豆：三颗糖豆绕环公转，自转反向保持姿态 -->
        <Canvas Width="104" Height="104" RenderTransformOrigin="0.5,0.5">
          <Canvas.RenderTransform><RotateTransform x:Name="OrbitRot"/></Canvas.RenderTransform>
          <Canvas Width="104" Height="104" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform><RotateTransform Angle="0"/></Canvas.RenderTransform>
            <Ellipse x:Name="DotA" Width="9" Height="9" Fill="#FF8A5C" Canvas.Left="47.5" Canvas.Top="4"/>
          </Canvas>
          <Canvas Width="104" Height="104" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform><RotateTransform Angle="120"/></Canvas.RenderTransform>
            <Ellipse x:Name="DotB" Width="8" Height="8" Fill="#E6B84C" Canvas.Left="48" Canvas.Top="4.5"/>
          </Canvas>
          <Canvas Width="104" Height="104" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform><RotateTransform Angle="240"/></Canvas.RenderTransform>
            <Ellipse x:Name="DotC" Width="7" Height="7" Fill="#8B7CF6" Canvas.Left="48.5" Canvas.Top="5"/>
          </Canvas>
        </Canvas>

        <!-- 棉花糖本体：软乎乎地呼吸挤压 -->
        <Border x:Name="Mallow" Width="40" Height="40" CornerRadius="14"
                RenderTransformOrigin="0.5,0.5">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop x:Name="MallowStopA" Color="#3A3246" Offset="0"/>
              <GradientStop x:Name="MallowStopB" Color="#2A2238" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Border.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="MallowScale"/>
              <RotateTransform x:Name="MallowRot"/>
            </TransformGroup>
          </Border.RenderTransform>
          <Viewbox Width="15" Height="15">
            <Path x:Name="Bolt" Fill="#8B7CF6" Data="M13 2L4 14h6l-1 8 9-12h-6z"/>
          </Viewbox>
        </Border>
      </Grid>

      <!-- 标题字母（代码后置逐字构建，弹跳入场） -->
      <StackPanel x:Name="TitleHost" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"/>

      <TextBlock x:Name="LblHint" Text="正在为你拨开云层…" HorizontalAlignment="Center"
                 Margin="0,9,0,0" FontSize="12.5" Foreground="#B8AEC0" Opacity="0">
        <TextBlock.RenderTransform><TranslateTransform x:Name="HintXf" Y="8"/></TextBlock.RenderTransform>
      </TextBlock>

      <!-- 蹦跳的加载糖豆 -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
        <Ellipse x:Name="HopA" Width="9" Height="9" Fill="#8B7CF6" Margin="5,0" Opacity="0" RenderTransformOrigin="0.5,1">
          <Ellipse.RenderTransform>
            <TransformGroup>
              <TranslateTransform x:Name="HopAXf"/>
              <ScaleTransform x:Name="HopAScale" ScaleY="1"/>
            </TransformGroup>
          </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="HopB" Width="9" Height="9" Fill="#FF8A5C" Margin="5,0" Opacity="0" RenderTransformOrigin="0.5,1">
          <Ellipse.RenderTransform>
            <TransformGroup>
              <TranslateTransform x:Name="HopBXf"/>
              <ScaleTransform x:Name="HopBScale" ScaleY="1"/>
            </TransformGroup>
          </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="HopC" Width="9" Height="9" Fill="#E6B84C" Margin="5,0" Opacity="0" RenderTransformOrigin="0.5,1">
          <Ellipse.RenderTransform>
            <TransformGroup>
              <TranslateTransform x:Name="HopCXf"/>
              <ScaleTransform x:Name="HopCScale" ScaleY="1"/>
            </TransformGroup>
          </Ellipse.RenderTransform>
        </Ellipse>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
