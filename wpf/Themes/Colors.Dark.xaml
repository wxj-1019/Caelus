<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== 语义色（Apple system colors · Dark） ===== -->
  <Color x:Key="SuccessColor">#32D74B</Color>
  <Color x:Key="WarningColor">#FF9F0A</Color>
  <Color x:Key="DangerColor">#FF453A</Color>
  <Color x:Key="InfoColor">#64D2FF</Color>
  <Color x:Key="BrandColor">#D4A847</Color>

  <!-- ===== 语义柔色（状态 chip 等浅底 tint；深色用亮语义色低 alpha） ===== -->
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2432D74B"/>
  <SolidColorBrush x:Key="SuccessEdgeBrush" Color="#5432D74B"/>
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#24FF9F0A"/>
  <SolidColorBrush x:Key="WarningEdgeBrush" Color="#54FF9F0A"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#24FF453A"/>
  <SolidColorBrush x:Key="DangerEdgeBrush" Color="#54FF453A"/>
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#2064D2FF"/>
  <SolidColorBrush x:Key="InfoEdgeBrush" Color="#4D64D2FF"/>
  <SolidColorBrush x:Key="NeutralSoftBrush" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="NeutralEdgeBrush" Color="#2EFFFFFF"/>

  <!-- ===== 表面梯度（macOS 深色中性灰：无蓝偏、非纯黑；背景 90% 不透明透出 DWM Acrylic 毛玻璃） ===== -->
  <Color x:Key="BackgroundColor">#E6171718</Color>
  <Color x:Key="Surface0Color">#CC1E1E20</Color>
  <Color x:Key="Surface1Color">#D8262628</Color>
  <Color x:Key="Surface2Color">#E02E2E31</Color>

  <!-- ===== 文字（Apple Dark：#F5F5F7 + 60%/55% 白；tertiary 55% 保证 10px 小字可读） ===== -->
  <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
  <Color x:Key="TextSecondaryColor">#99EBEBF5</Color>
  <Color x:Key="TextTertiaryColor">#8CEBEBF5</Color>
  <Color x:Key="ButtonSheenColor">#4DFFFFFF</Color>

  <!-- ===== 画刷 ===== -->
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
  <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}"/>
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
  <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0Color}"/>
  <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}"/>
  <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>

  <!-- ===== 描边体系（发丝线：上亮下隐渐变 + 卡顶高光线，alpha 收敛更克制） ===== -->
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#2EFFFFFF"/>
  <LinearGradientBrush x:Key="TopHighlightBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00FFFFFF" Offset="0"/>
    <GradientStop Color="#4DFFFFFF" Offset="0.5"/>
    <GradientStop Color="#00FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardEdgeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#3DFFFFFF" Offset="0"/>
    <GradientStop Color="#14FFFFFF" Offset="0.45"/>
    <GradientStop Color="#08FFFFFF" Offset="1"/>
  </LinearGradientBrush>

  <!-- ===== 分段控件选中态（macOS 深色：中性灰滑块 + 白字） ===== -->
  <SolidColorBrush x:Key="SegSelectedBrush" Color="#636366"/>
  <SolidColorBrush x:Key="SegSelectedTextBrush" Color="#FFFFFF"/>

  <!-- ===== 滚动条（macOS 悬浮 overlay：无轨道，胶囊 thumb；常态 55% 白，hover 70% 提亮，拖动用模式色） ===== -->
  <SolidColorBrush x:Key="ScrollTrackBrush" Color="Transparent"/>
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8CFFFFFF"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#B3FFFFFF"/>

  <!-- ===== 兼容别名层（旧视图/样式引用，逐页精修后回收；勿在新代码中使用） ===== -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="#D9202022"/>
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#262628"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#2E2E32"/>
  <SolidColorBrush x:Key="GlassNavBrush" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="GlassCardBrush" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="GlassHeroBrush" Color="#22FFFFFF"/>
  <SolidColorBrush x:Key="GlassRaisedBrush" Color="#29FFFFFF"/>
  <SolidColorBrush x:Key="GlassBorderBrush" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="GlassBorderHiBrush" Color="#38FFFFFF"/>
  <SolidColorBrush x:Key="InnerHighlightBrush" Color="#33FFFFFF"/>
  <SolidColorBrush x:Key="TrackBrush" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="ModeAccentBrush" Color="{DynamicResource ModeAccentOnDarkColor}"/>
</ResourceDictionary>
