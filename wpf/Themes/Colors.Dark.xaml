<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== 棉花糖天空 · 深色（棉花糖夜空）=====
       深梅子夜空底 + 梅子卡片，暖奶油/薰衣草灰文字三阶；
       糖果紫品牌色，糖果光晕在夜色里更显软糯。 -->

  <!-- 语义色（深色底可读，略收敛） -->
  <Color x:Key="SuccessColor">#3DD68C</Color>
  <Color x:Key="WarningColor">#E5A13D</Color>
  <Color x:Key="DangerColor">#F2555A</Color>
  <Color x:Key="InfoColor">#4C9BE8</Color>
  <Color x:Key="BrandColor">#A78BFA</Color>

  <!-- 语义柔色（深色用亮语义色低 alpha） -->
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#203DD68C"/>
  <SolidColorBrush x:Key="SuccessEdgeBrush" Color="#503DD68C"/>
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#20E5A13D"/>
  <SolidColorBrush x:Key="WarningEdgeBrush" Color="#50E5A13D"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#20F2555A"/>
  <SolidColorBrush x:Key="DangerEdgeBrush" Color="#50F2555A"/>
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#1E4C9BE8"/>
  <SolidColorBrush x:Key="InfoEdgeBrush" Color="#4A4C9BE8"/>
  <SolidColorBrush x:Key="NeutralSoftBrush" Color="#10FFFFFF"/>
  <SolidColorBrush x:Key="NeutralEdgeBrush" Color="#26FFFFFF"/>

  <!-- 表面梯度：柔和深灰底 + 暗卡片（越高越亮一点，发丝线分层） -->
  <Color x:Key="BackgroundColor">#FF1B1524</Color>
  <Color x:Key="Surface0Color">#FF241D30</Color>
  <Color x:Key="Surface1Color">#FF2A2236</Color>
  <Color x:Key="Surface2Color">#FF31283E</Color>

  <!-- 文字：排版驱动层级 -->
  <Color x:Key="TextPrimaryColor">#F7F1EA</Color>
  <Color x:Key="TextSecondaryColor">#B8AEC0</Color>
  <Color x:Key="TextTertiaryColor">#9689A5</Color>
  <Color x:Key="ButtonSheenColor">#2EFFFFFF</Color>

  <!-- 画刷 -->
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
  <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}"/>
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
  <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0Color}"/>
  <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}"/>
  <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>

  <!-- 描边：发丝线（白色低 alpha）；去高光/渐变装饰 -->
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#2EFFFFFF"/>
  <LinearGradientBrush x:Key="TopHighlightBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00FFFFFF" Offset="0"/>
    <GradientStop Color="#00FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="CardEdgeBrush" Color="#1AFFFFFF"/>

  <!-- 分段控件选中态（暗底上亮滑块 + 深字） -->
  <SolidColorBrush x:Key="SegSelectedBrush" Color="#3A3246"/>
  <SolidColorBrush x:Key="SegSelectedTextBrush" Color="#F7F1EA"/>

  <!-- 滚动条（无轨道，细胶囊 thumb） -->
  <SolidColorBrush x:Key="ScrollTrackBrush" Color="Transparent"/>
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4DFFFFFF"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#73FFFFFF"/>

  <!-- 兼容别名层（保留 key 防旧视图/样式解析失败；值已改为极简表面） -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FA1E1E23"/>
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF24242A"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="GlassNavBrush" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="GlassCardBrush" Color="#FA1E1E23"/>
  <SolidColorBrush x:Key="GlassHeroBrush" Color="#FA1E1E23"/>
  <SolidColorBrush x:Key="GlassRaisedBrush" Color="#FF24242A"/>
  <SolidColorBrush x:Key="GlassBorderBrush" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="GlassBorderHiBrush" Color="#2EFFFFFF"/>
  <SolidColorBrush x:Key="InnerHighlightBrush" Color="#00FFFFFF"/>
  <SolidColorBrush x:Key="TrackBrush" Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="ModeAccentBrush" Color="{DynamicResource ModeAccentOnDarkColor}"/>
</ResourceDictionary>
