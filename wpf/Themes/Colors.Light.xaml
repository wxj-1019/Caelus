<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== 棉花糖天空 · 浅色（棉花糖白天）=====
       奶油暖底 + 白棉花糖卡片，暖可可/暖褐文字三阶；
       糖果紫品牌色，层级靠留白与发丝线，暖调营造柔软氛围。 -->

  <!-- 语义色（克制、专业，白底可读） -->
  <Color x:Key="SuccessColor">#248A3D</Color>
  <Color x:Key="WarningColor">#C07A1B</Color>
  <Color x:Key="DangerColor">#D70015</Color>
  <Color x:Key="InfoColor">#2F7BD6</Color>
  <Color x:Key="BrandColor">#8B7CF6</Color>

  <!-- 语义柔色（浅底 tint，低 alpha） -->
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#16248A3D"/>
  <SolidColorBrush x:Key="SuccessEdgeBrush" Color="#4D248A3D"/>
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#14C07A1B"/>
  <SolidColorBrush x:Key="WarningEdgeBrush" Color="#4DC07A1B"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#12D70015"/>
  <SolidColorBrush x:Key="DangerEdgeBrush" Color="#47D70015"/>
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#122F7BD6"/>
  <SolidColorBrush x:Key="InfoEdgeBrush" Color="#472F7BD6"/>
  <SolidColorBrush x:Key="NeutralSoftBrush" Color="#08000000"/>
  <SolidColorBrush x:Key="NeutralEdgeBrush" Color="#1A000000"/>

  <!-- 表面梯度： airy 灰底 + 纯白卡片（高层级=更灰的悬停/浮起，靠发丝线分层） -->
  <Color x:Key="BackgroundColor">#FFFBF4EE</Color>
  <Color x:Key="Surface0Color">#FFFFFFFF</Color>
  <Color x:Key="Surface1Color">#FFFFF7F2</Color>
  <Color x:Key="Surface2Color">#FFF5EDE7</Color>

  <!-- 文字：排版驱动层级（主/次/辅三阶，对比度达标） -->
  <Color x:Key="TextPrimaryColor">#2B1F1A</Color>
  <Color x:Key="TextSecondaryColor">#6B5D55</Color>
  <Color x:Key="TextTertiaryColor">#7F6E64</Color>
  <Color x:Key="ButtonSheenColor">#33FFFFFF</Color>

  <!-- 画刷 -->
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
  <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}"/>
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
  <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0Color}"/>
  <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}"/>
  <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>

  <!-- 夜空烟花：Hero 渐变标题（暖可可 → 深薰衣草；首 Stop 引用 TextPrimaryColor 保持同源）。
       对角渐变线（0,0 → 1,0.5 ≈26.6° 下斜）对应沙盒 .hero-title 的 120deg CSS 渐变方向 -->
  <LinearGradientBrush x:Key="HeroTitleBrush" StartPoint="0,0" EndPoint="1,0.5">
    <GradientStop Color="{StaticResource TextPrimaryColor}" Offset="0.3"/>
    <GradientStop Color="#6D5CE0" Offset="1"/>
  </LinearGradientBrush>
  <!-- 场景卡图标着色：开发=成功绿（引用 SuccessColor）、日常=蜜桃橙（无对应 Color 资源，保持硬编码） -->
  <SolidColorBrush x:Key="ScenarioDevBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="ScenarioDailyBrush" Color="#B84518"/>
  <SolidColorBrush x:Key="ScenarioDevSoftBrush" Color="#248A3D26"/>
  <SolidColorBrush x:Key="ScenarioDailySoftBrush" Color="#B8451824"/>

  <!-- 描边：发丝线（黑色低 alpha，≈#E7E7EA / #D4D4D8）；去掉卡顶高光与渐变描边的装饰 -->
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#17000000"/>
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#26000000"/>
  <LinearGradientBrush x:Key="TopHighlightBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00FFFFFF" Offset="0"/>
    <GradientStop Color="#00FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="CardEdgeBrush" Color="#17000000"/>

  <!-- 分段控件选中态（白滑块 + 深字） -->
  <SolidColorBrush x:Key="SegSelectedBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SegSelectedTextBrush" Color="#2B1F1A"/>

  <!-- 滚动条（2px 玻璃：淡轨道 + 渐变玻璃胶囊 thumb） -->
  <SolidColorBrush x:Key="ScrollTrackBrush" Color="#0F000000"/>
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#59000000"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8C000000"/>
  <SolidColorBrush x:Key="ScrollGlassBrush" Color="#73000000"/>
  <SolidColorBrush x:Key="ScrollGlassEdgeBrush" Color="#33000000"/>
  <Color x:Key="ScrollGlassColor">#73000000</Color>

  <!-- 关闭按钮悬停（Windows 11 系统规范红） -->
  <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C"/>

  <!-- 兼容别名层（保留 key 防旧视图/样式解析失败；值已改为极简表面） -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFFFFFF"/>
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFF6F6F8"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#1A000000"/>
  <SolidColorBrush x:Key="GlassNavBrush" Color="#08000000"/>
  <SolidColorBrush x:Key="GlassCardBrush" Color="#FCFFFFFF"/>
  <SolidColorBrush x:Key="GlassHeroBrush" Color="#FCFFFFFF"/>
  <SolidColorBrush x:Key="GlassRaisedBrush" Color="#FFF6F6F8"/>
  <SolidColorBrush x:Key="GlassBorderBrush" Color="#17000000"/>
  <SolidColorBrush x:Key="GlassBorderHiBrush" Color="#26000000"/>
  <SolidColorBrush x:Key="InnerHighlightBrush" Color="#00FFFFFF"/>
  <SolidColorBrush x:Key="TrackBrush" Color="#10000000"/>
  <SolidColorBrush x:Key="ModeAccentBrush" Color="{DynamicResource ModeAccentOnLightColor}"/>
</ResourceDictionary>
