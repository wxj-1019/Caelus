<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- 棉花糖天空 · 竞技模式 · 蜜桃橙（糖果蜜桃） ===== -->

  <Color x:Key="AuroraPrimaryColor">#FF8A5C</Color>
  <Color x:Key="AuroraPrimaryFadeColor">#00FF8A5C</Color>
  <Color x:Key="AuroraSecondaryColor">#FFA07A</Color>
  <Color x:Key="AuroraSecondaryFadeColor">#00FFA07A</Color>
  <Color x:Key="AuroraTertiaryColor">#FFC4B0</Color>
  <Color x:Key="AuroraTertiaryFadeColor">#00FFC4B0</Color>
  <sys:Double x:Key="AuroraPrimaryOpacity">0.16</sys:Double>
  <sys:Double x:Key="AuroraSecondaryOpacity">0.10</sys:Double>
  <sys:Double x:Key="AuroraTertiaryOpacity">0.06</sys:Double>
  <sys:Double x:Key="AuroraDriftSeconds">22</sys:Double>

  <RadialGradientBrush x:Key="AmbientPrimaryBrush" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
    <GradientStop Color="{DynamicResource AuroraPrimaryColor}" Offset="0"/>
    <GradientStop Color="{DynamicResource AuroraPrimaryFadeColor}" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientSecondaryBrush" Center="0.5,0.5" RadiusX="0.68" RadiusY="0.68">
    <GradientStop Color="{DynamicResource AuroraSecondaryColor}" Offset="0"/>
    <GradientStop Color="{DynamicResource AuroraSecondaryFadeColor}" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientTertiaryBrush" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
    <GradientStop Color="{DynamicResource AuroraTertiaryColor}" Offset="0"/>
    <GradientStop Color="{DynamicResource AuroraTertiaryFadeColor}" Offset="1"/>
  </RadialGradientBrush>

  <Color x:Key="AccentPrimaryColor">#FF8A5C</Color>
  <Color x:Key="AccentSecondaryColor">#FFA07A</Color>
  <Color x:Key="AccentGlowColor">#FF8A5C</Color>
  <!-- 明暗桥接色键（规格 2026-09-29 §4.2 偏差修正）：画刷迁色板槽，此处只留色值。
       OnDark=现共享值；竞技模式 OnLight 保持现值不动 -->
  <Color x:Key="AccentSoftOnDarkColor">#16FF8A5C</Color>
  <Color x:Key="AccentEdgeOnDarkColor">#44FF8A5C</Color>
  <Color x:Key="OnAccentOnDarkColor">#2B1F1A</Color>
  <Color x:Key="AccentPrimaryOnLightColor">#FF8A5C</Color>
  <Color x:Key="AccentSecondaryOnLightColor">#FFA07A</Color>
  <Color x:Key="AccentSoftOnLightColor">#16FF8A5C</Color>
  <Color x:Key="AccentEdgeOnLightColor">#44FF8A5C</Color>
  <Color x:Key="AccentGlowOnLightColor">#FF8A5C</Color>
  <Color x:Key="OnAccentOnLightColor">#2B1F1A</Color>

  <Color x:Key="ModeAccentOnDarkColor">#FFA07A</Color>
  <Color x:Key="ModeAccentOnLightColor">#B84518</Color>
  <SolidColorBrush x:Key="ModeAccentOnDarkBrush" Color="{StaticResource ModeAccentOnDarkColor}"/>
  <SolidColorBrush x:Key="ModeAccentOnLightBrush" Color="{StaticResource ModeAccentOnLightColor}"/>
  <SolidColorBrush x:Key="ModeAccentSoftBrush" Color="#16FF8A5C"/>
  <SolidColorBrush x:Key="ModeAccentEdgeBrush" Color="#44FF8A5C"/>

  <SolidColorBrush x:Key="HeroTitleOnDarkBrush" Color="#FFA07A"/>
  <SolidColorBrush x:Key="HeroTitleOnLightBrush" Color="#B84518"/>
</ResourceDictionary>
