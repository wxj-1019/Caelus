<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- 棉花糖天空 · 常规模式 · 棉花糖紫（糖果薰衣草） =====
       大胆软糯：亮糖果色作填充/图标，深可可字落在糖果底上保证对比度；
       Aurora 光晕回填为低透明软光，营造棉花糖云朵氛围。 -->

  <!-- 棉花糖氛围光晕（软糯低透明，云朵感） -->
  <Color x:Key="AuroraPrimaryColor">#8B7CF6</Color>
  <Color x:Key="AuroraPrimaryFadeColor">#008B7CF6</Color>
  <Color x:Key="AuroraSecondaryColor">#A78BFA</Color>
  <Color x:Key="AuroraSecondaryFadeColor">#00A78BFA</Color>
  <Color x:Key="AuroraTertiaryColor">#C7B8F0</Color>
  <Color x:Key="AuroraTertiaryFadeColor">#00C7B8F0</Color>
  <sys:Double x:Key="AuroraPrimaryOpacity">0.18</sys:Double>
  <sys:Double x:Key="AuroraSecondaryOpacity">0.12</sys:Double>
  <sys:Double x:Key="AuroraTertiaryOpacity">0.08</sys:Double>
  <sys:Double x:Key="AuroraDriftSeconds">26</sys:Double>

  <RadialGradientBrush x:Key="AmbientPrimaryBrush" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
    <GradientStop Color="{DynamicResource AuroraPrimaryColor}" Offset="0"/>
    <GradientStop Color="{DynamicResource AuroraPrimaryFadeColor}" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientSecondaryBrush" Center="0.5,0.5" RadiusX="0.68" RadiusY="0.68">
    <GradientStop Color="{DynamicResource AuroraSecondaryColor}" Offset="0"/>
    <GradientStop Color="{DynamicResource AuroraSecondaryFadeColor}" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientTertiaryBrush" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
    <GradientStop Color="{DynamicResource AuroraTertiaryColor}" Offset="0"/>
    <GradientStop Color="{DynamicResource AuroraTertiaryFadeColor}" Offset="1"/>
  </RadialGradientBrush>

  <!-- 糖果薰衣草：亮紫填充 + 浅紫渐变第二档（画刷迁色板槽，此处只留色值） -->
  <Color x:Key="AccentPrimaryColor">#8B7CF6</Color>
  <Color x:Key="AccentSecondaryColor">#A78BFA</Color>
  <Color x:Key="AccentGlowColor">#8B7CF6</Color>
  <!-- 明暗桥接色键（规格 2026-09-29 §4.2 偏差修正）：画刷迁色板槽，此处只留色值。
       OnDark=现共享值；Standard 的 OnLight 六键由 Task 8 改抹茶值 -->
  <Color x:Key="AccentSoftOnDarkColor">#168B7CF6</Color>
  <Color x:Key="AccentEdgeOnDarkColor">#408B7CF6</Color>
  <Color x:Key="OnAccentOnDarkColor">#2B1F1A</Color>
  <Color x:Key="AccentPrimaryOnLightColor">#7CB68F</Color>
  <Color x:Key="AccentSecondaryOnLightColor">#A8D5B5</Color>
  <Color x:Key="AccentSoftOnLightColor">#147CB68F</Color>
  <Color x:Key="AccentEdgeOnLightColor">#407CB68F</Color>
  <Color x:Key="AccentGlowOnLightColor">#7CB68F</Color>
  <Color x:Key="OnAccentOnLightColor">#1E3328</Color>

  <!-- 兼容别名层（旧 NavItem/按钮引用） -->
  <Color x:Key="ModeAccentOnDarkColor">#A78BFA</Color>
  <Color x:Key="ModeAccentOnLightColor">#3F7A58</Color>
  <SolidColorBrush x:Key="ModeAccentOnDarkBrush" Color="{StaticResource ModeAccentOnDarkColor}"/>
  <SolidColorBrush x:Key="ModeAccentOnLightBrush" Color="{StaticResource ModeAccentOnLightColor}"/>
  <SolidColorBrush x:Key="ModeAccentSoftBrush" Color="#168B7CF6"/>
  <SolidColorBrush x:Key="ModeAccentEdgeBrush" Color="#408B7CF6"/>

  <!-- Hero 结论标题 -->
  <SolidColorBrush x:Key="HeroTitleOnDarkBrush" Color="#A78BFA"/>
  <SolidColorBrush x:Key="HeroTitleOnLightBrush" Color="#6D5CE0"/>
</ResourceDictionary>
