<UserControl x:Class="CaelusApp.WpfHost.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="0,0,0,16">
    <!-- Hero -->
    <Border Style="{DynamicResource HeroCardBorder}" Padding="20" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="CAELUS" FontSize="{DynamicResource FontSizeDisplay}" FontWeight="Bold"
                   Foreground="{DynamicResource ModeAccentBrush}"/>
      </StackPanel>
    </Border>

    <!-- 信息卡 -->
    <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="PROJECT // IDENTITY" FontSize="11" FontWeight="Bold"
                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,10"/>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="版本" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="作者" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Grid.Column="1" Text="{Binding AuthorText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="仓库" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Grid.Column="1" Text="{Binding RepoText}" FontSize="12" Foreground="{DynamicResource ModeAccentBrush}"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- 更新卡 -->
    <Border Style="{DynamicResource CardBorder}">
      <StackPanel>
        <TextBlock Text="{Binding UpdateTitle}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding UpdateSubText}" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnCheckUpdate" Content="{Binding CheckUpdateText}" Click="OnCheckUpdate"
                  Style="{DynamicResource PrimaryButton}" Padding="16,6"/>
          <TextBlock x:Name="LblUpdateStatus" Text="" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
