<UserControl x:Class="CaelusApp.WpfHost.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="关于 Caelus">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">
      <StackPanel x:Name="ZoneHeader" Margin="0,0,0,16">
        <TextBlock Text="关于" Style="{DynamicResource PageHeader}"/>
        <TextBlock Text="版本、项目与更新" Style="{DynamicResource PageSubtitle}" Margin="0,4,0,0"/>
      </StackPanel>

      <Grid x:Name="ZoneBrand" Margin="2,0,2,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="CAELUS" FontSize="{DynamicResource FontSizeDisplay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="Windows 性能守护" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{DynamicResource InfoStatusBadge}" VerticalAlignment="Center" Margin="24,0,0,0">
          <TextBlock Text="{Binding VersionText}" FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSizeMono}" Foreground="{DynamicResource InfoBrush}"/>
        </Border>
      </Grid>

      <Border x:Name="ZoneInfo" Style="{DynamicResource SettingsGroup}" Margin="0,0,0,16">
        <StackPanel>
          <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="版本" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextPrimaryBrush}"/></Grid></Border>
          <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="作者" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding AuthorText}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/></Grid></Border>
          <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="仓库" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"><Hyperlink NavigateUri="{Binding RepoText}" RequestNavigate="OnNavigate" Foreground="{DynamicResource ModeAccentBrush}"><Run Text="{Binding RepoDisplayText, Mode=OneWay}"/></Hyperlink></TextBlock></Grid></Border>
          <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="发布页" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" FontSize="{DynamicResource FontSizeCaption}"><Hyperlink NavigateUri="{Binding ReleaseUrl}" RequestNavigate="OnNavigate" Foreground="{DynamicResource ModeAccentBrush}">查看版本发布与更新说明</Hyperlink></TextBlock></Grid></Border>
          <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="许可证" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding LicenseText}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextPrimaryBrush}"/></Grid></Border>
          <Border Style="{DynamicResource PolicyRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="诊断信息" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding DiagnosticsText}" FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/></Grid></Border>
        </StackPanel>
      </Border>

      <Border x:Name="ZoneUpdate" Style="{DynamicResource SettingsGroup}">
        <Border Style="{DynamicResource PolicyRow}">
          <StackPanel>
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Button x:Name="BtnDownload" Content="{Binding DownloadText}" Click="OnDownload" Padding="14,6" Margin="0,0,8,0" AutomationProperties.Name="前往下载最新版本">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UpdateAvailable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button x:Name="BtnCheckUpdate" Content="{Binding CheckUpdateText}" Click="OnCheckUpdate" Style="{DynamicResource GhostButton}" Padding="14,6" AutomationProperties.Name="检查 Caelus 更新"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdateTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding UpdateSubText}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
            <Border Margin="0,12,0,0">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource StatusBanner}"><Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource InfoEdgeBrush}"/><Style.Triggers><DataTrigger Binding="{Binding UpdateStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding UpdateKind}" Value="Success"><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SuccessEdgeBrush}"/></DataTrigger><DataTrigger Binding="{Binding UpdateKind}" Value="Error"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerEdgeBrush}"/></DataTrigger></Style.Triggers></Style>
              </Border.Style>
              <TextBlock x:Name="LblUpdateStatus" Text="{Binding UpdateStatus}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.Name="更新检查状态"/>
            </Border>
          </StackPanel>
        </Border>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
