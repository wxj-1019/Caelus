<UserControl x:Class="CaelusApp.WpfHost.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="实时监控">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">
      <StackPanel x:Name="ZoneHeader" Margin="0,0,0,16">
        <TextBlock x:Name="HdrTitle" Text="实时监控" Style="{DynamicResource PageHeader}"/>
        <TextBlock x:Name="HdrSub" Text="Caelus 此刻在做什么——掌权状态、压制与提优清单、最近动作" Style="{DynamicResource PageSubtitle}"/>
      </StackPanel>

      <!-- 实时状态：三场景瓦片 -->
      <Border Style="{DynamicResource SettingsGroup}" Padding="16,14" Margin="0,0,0,16"
              AutomationProperties.Name="实时状态">
        <StackPanel>
          <TextBlock Text="实时状态" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="每 2 秒自动刷新；被更高优先级场景抢占时低优先级场景立即还原式挂起。"
                     Margin="0,3,0,10" FontSize="{DynamicResource FontSizeXs}"
                     Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding StatusRows}" AutomationProperties.Name="场景状态列表">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1" Padding="0,8">
                  <DockPanel>
                    <Border DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="64"
                            CornerRadius="{DynamicResource RadiusSm}" Padding="8,3"
                            Background="{DynamicResource Surface1Brush}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding StateKey}" Value="Success">
                              <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StateKey}" Value="Warning">
                              <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding StateText}" HorizontalAlignment="Center"
                                 FontSize="{DynamicResource FontSizeXs}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" FontSize="{DynamicResource FontSizeXs}"
                                 Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding TodayText}" Margin="0,10,0,0" FontSize="{DynamicResource FontSizeSmall}"
                     Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- 实时压制清单 -->
      <Border Style="{DynamicResource SettingsGroup}" Padding="16,14" Margin="0,0,0,16"
              AutomationProperties.Name="实时压制清单">
        <StackPanel>
          <TextBlock Text="{Binding SuppressedHeader}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="70"/>
              <ColumnDefinition Width="60"/><ColumnDefinition Width="110"/>
              <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="进程" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Grid.Column="1" Text="PID" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Grid.Column="2" Text="档位" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Grid.Column="3" Text="来源" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Grid.Column="4" Text="已压制" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding SuppressedRows}" AutomationProperties.Name="压制进程表">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1" Padding="0,7">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="70"/>
                      <ColumnDefinition Width="60"/><ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding PidText}" FontSize="{DynamicResource FontSizeXs}"
                               Foreground="{DynamicResource TextTertiaryBrush}" FontFamily="{DynamicResource FontMono}"/>
                    <TextBlock Grid.Column="2" Text="{Binding LevelText}" FontSize="{DynamicResource FontSizeXs}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="{Binding ReasonsText}" FontSize="{DynamicResource FontSizeXs}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="{DynamicResource FontSizeXs}"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 实时提优清单 -->
      <Border Style="{DynamicResource SettingsGroup}" Padding="16,14" Margin="0,0,0,16"
              AutomationProperties.Name="实时提优清单">
        <StackPanel>
          <TextBlock Text="{Binding BoostHeader}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <ItemsControl ItemsSource="{Binding BoostRows}" Margin="0,8,0,0" AutomationProperties.Name="提优进程表">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1" Padding="0,7">
                  <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeSmall}"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 最近动作流 -->
      <Border Style="{DynamicResource SettingsGroup}" Padding="16,14"
              AutomationProperties.Name="最近动作流">
        <StackPanel>
          <TextBlock Text="最近动作" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="掌权、压制、阻断、拉起、维护与对局的最近 30 条动作（内存缓冲，不落盘）。"
                     Margin="0,3,0,8" FontSize="{DynamicResource FontSizeXs}"
                     Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding FeedRows}" AutomationProperties.Name="动作流列表">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1" Padding="0,6">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" Width="64"
                               FontSize="{DynamicResource FontSizeXs}" FontFamily="{DynamicResource FontMono}"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Text}" FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
