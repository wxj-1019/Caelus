<UserControl x:Class="CaelusApp.WpfHost.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CaelusApp.WpfHost.Controls"
             AutomationProperties.Name="实时监控">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">
      <StackPanel x:Name="ZoneHeader" Margin="0,0,0,16">
        <TextBlock x:Name="HdrTitle" Text="实时监控" Style="{DynamicResource PageHeader}"/>
        <TextBlock x:Name="HdrSub" Text="Caelus 此刻在做什么——掌权状态、压制与提优清单、最近动作" Style="{DynamicResource PageSubtitle}"/>
      </StackPanel>

      <!-- 场景状态：夜空烟花 Hero + 三瓦片大字状态 -->
      <controls:GlassCard x:Name="ZoneStatus" Style="{DynamicResource HeroGlassCard}" Margin="0,0,0,16"
              AutomationProperties.Name="实时状态">
        <Grid>
          <Border Style="{StaticResource AuroraPrimaryHost}"/>
          <Border Style="{StaticResource AuroraSecondaryHost}"/>
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <Border DockPanel.Dock="Right" Style="{DynamicResource NeutralStatusBadge}" VerticalAlignment="Center">
                <TextBlock Text="每 2 秒刷新" FontSize="{DynamicResource FontSizeXs}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
              </Border>
              <TextBlock Text="实时状态" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding StatusRows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4,12,4">
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,8,0">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{DynamicResource NeutralEdgeBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding StateKey}" Value="Success">
                                  <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StateKey}" Value="Warning">
                                  <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Text="{Binding StateText}" FontSize="{DynamicResource FontSizeDisplay}" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding StateKey}" Value="Success">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding StateKey}" Value="Warning">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" FontSize="{DynamicResource FontSizeXs}"
                                 Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </controls:GlassCard>

      <!-- 今日统计：大数字格 -->
      <controls:GlassCard Margin="0,0,0,16" AutomationProperties.Name="今日统计">
        <ItemsControl ItemsSource="{Binding StatCells}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,2" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding Value}" Style="{DynamicResource MetricNumber}"
                             HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                  <TextBlock Text="{Binding Label}" Margin="0,3,0,0" FontSize="{DynamicResource FontSizeXs}"
                             Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
      </controls:GlassCard>

      <!-- 实时压制 -->
      <Border Style="{DynamicResource SettingsGroup}" Padding="16,14" Margin="0,0,0,16"
              AutomationProperties.Name="实时压制清单">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <Border DockPanel.Dock="Right" Style="{DynamicResource InfoStatusBadge}" VerticalAlignment="Center">
              <TextBlock Text="{Binding SuppressedHeader}" FontSize="{DynamicResource FontSizeXs}"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource SectionHeaderIcon}" Margin="0,0,10,0">
                <controls:IconView Key="IconShield" Width="15" Height="15" Foreground="{DynamicResource ModeAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="压制中的进程" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>

          <!-- 空态 -->
          <StackPanel Visibility="{Binding SuppressedEmpty, Converter={StaticResource BoolVis}}"
                      Margin="0,6,0,4">
            <TextBlock Text="一切平静——没有进程被压制" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
          </StackPanel>

          <!-- 表头 -->
          <Grid Margin="0,4,0,0" Visibility="{Binding SuppressedAny, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="70"/>
              <ColumnDefinition Width="64"/><ColumnDefinition Width="120"/>
              <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="进程" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Grid.Column="1" Text="PID" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Grid.Column="2" Text="档位" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Grid.Column="3" Text="来源" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Grid.Column="4" Text="已压制" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Right"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding SuppressedRows}" AutomationProperties.Name="压制进程表">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1" Padding="0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="70"/>
                      <ColumnDefinition Width="64"/><ColumnDefinition Width="120"/>
                      <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding PidText}" FontSize="{DynamicResource FontSizeXs}"
                               Foreground="{DynamicResource TextTertiaryBrush}" FontFamily="{DynamicResource FontMono}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                            CornerRadius="{DynamicResource RadiusSm}" Padding="7,2" Margin="0,0,8,0">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding LevelKey}" Value="Info">
                              <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LevelKey}" Value="Warning">
                              <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LevelKey}" Value="Error">
                              <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding LevelText}" FontSize="{DynamicResource FontSizeXs}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <ItemsControl Grid.Column="3" ItemsSource="{Binding ReasonList}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border CornerRadius="{DynamicResource RadiusSm}" Padding="6,1" Margin="0,0,4,0"
                                  Background="{DynamicResource Surface1Brush}">
                            <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeXs}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="{DynamicResource FontSizeXs}"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Right"
                               VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 实时提优 -->
      <Border Style="{DynamicResource SettingsGroup}" Padding="16,14" Margin="0,0,0,16"
              AutomationProperties.Name="实时提优清单">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <Border DockPanel.Dock="Right" Style="{DynamicResource SuccessStatusBadge}" VerticalAlignment="Center">
              <TextBlock Text="{Binding BoostHeader}" FontSize="{DynamicResource FontSizeXs}"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource SectionHeaderIcon}" Margin="0,0,10,0">
                <controls:IconView Key="IconCode" Width="15" Height="15" Foreground="{DynamicResource ModeAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="提优中的进程" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <TextBlock Text="一切平静——没有进程被提优" FontSize="{DynamicResource FontSizeSmall}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     Visibility="{Binding BoostEmpty, Converter={StaticResource BoolVis}}"/>
          <WrapPanel>
            <ItemsControl ItemsSource="{Binding BoostRows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="{DynamicResource RadiusSm}" Padding="10,4" Margin="0,0,8,8"
                          Background="{DynamicResource AccentSoftBrush}"
                          BorderBrush="{DynamicResource AccentEdgeBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeXs}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- 最近动作流 -->
      <Border Style="{DynamicResource SettingsGroup}" Padding="16,14"
              AutomationProperties.Name="最近动作流">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <Border DockPanel.Dock="Right" Style="{DynamicResource NeutralStatusBadge}" VerticalAlignment="Center">
              <TextBlock Text="内存缓冲 · 不落盘" FontSize="{DynamicResource FontSizeXs}"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource SectionHeaderIcon}" Margin="0,0,10,0">
                <controls:IconView Key="IconActivity" Width="15" Height="15" Foreground="{DynamicResource ModeAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="最近动作" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding FeedRows}" AutomationProperties.Name="动作流列表">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1" Padding="0,7">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="3" Height="26" CornerRadius="1.5"
                            Background="{DynamicResource AccentPrimaryBrush}" Margin="0,0,10,0"
                            VerticalAlignment="Center" Opacity="0.55"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" Width="62"
                               FontSize="{DynamicResource FontSizeXs}" FontFamily="{DynamicResource FontMono}"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Text}" FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
