<UserControl x:Class="CaelusApp.WpfHost.Views.AntiCheatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CaelusApp.WpfHost.Controls"
             xmlns:local="clr-namespace:CaelusApp.WpfHost">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">

      <StackPanel x:Name="ZoneHeader" Margin="0,0,0,18">
        <TextBlock Text="{Binding PageTitle}" Style="{DynamicResource PageHeader}"/>
        <TextBlock Text="{Binding PageSub}" Style="{DynamicResource PageSubtitle}" Margin="0,3,0,0"/>
      </StackPanel>

      <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,16">
        <Border Style="{DynamicResource PolicyRow}">
          <DockPanel>
          <ToggleButton x:Name="SwMaster" Style="{DynamicResource PolicyToggle}"
                        IsChecked="{Binding MasterOn}"
                        AutomationProperties.Name="{Binding MasterTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding MasterTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding MasterSub}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
          </DockPanel>
        </Border>
      </Border>

      <!-- 分组小标题 -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Border Width="30" Height="30" CornerRadius="{DynamicResource RadiusSm}"
                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
          <Viewbox Width="16" Height="16">
            <Path Data="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6z" Stroke="{DynamicResource ModeAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
          </Viewbox>
        </Border>
        <TextBlock Text="{Binding BoundaryTitle}" FontSize="{DynamicResource FontSizeBody}"
                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
      </StackPanel>

      <Border Style="{DynamicResource SettingsGroup}">
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{DynamicResource PolicyRow}">
              <StackPanel>
                <DockPanel>
                  <ToggleButton Style="{DynamicResource PolicyToggle}"
                                IsChecked="{Binding Enabled}"
                                AutomationProperties.Name="{Binding Title}"
                                DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Desc}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                  <TextBlock Text="{Binding Status}" FontSize="11"
                             Foreground="{DynamicResource ModeAccentBrush}"
                             VerticalAlignment="Center" DockPanel.Dock="Right"
                             HorizontalAlignment="Right"/>
                  <ctl:SegmentedControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.LevelLabels}"
                                        SelectedIndex="{Binding LevelIndex, Mode=TwoWay}"
                                        SelectionChanged="OnLevelChanged"
                                        AutomationProperties.Name="{Binding Title}"
                                        HorizontalAlignment="Left"/>
                </DockPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
