<UserControl x:Class="CaelusApp.WpfHost.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="系统体检">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <DataTemplate x:Key="AuditResultRowTemplate">
      <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="120"/>
            <ColumnDefinition Width="3*" MinWidth="160"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Evidence}"
                       FontSize="10"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Value}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Warn}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Note}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{Binding PageTitle}" Style="{DynamicResource PageHeader}"/>
      <TextBlock Text="{Binding PageSub}"
                 Style="{DynamicResource PageSubtitle}"
                 Margin="0,4,0,0"/>
    </StackPanel>

    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
      <Button x:Name="BtnQuick"
              Style="{DynamicResource PrimaryButton}"
              Content="{Binding QuickText}"
              Click="OnQuickClick"
              IsEnabled="{Binding ButtonsEnabled}"
              AutomationProperties.Name="{Binding QuickText}"
              Margin="0,0,8,8"/>
      <Button x:Name="BtnPrecise"
              Style="{DynamicResource GhostButton}"
              Content="{Binding PreciseText}"
              Click="OnPreciseClick"
              IsEnabled="{Binding ButtonsEnabled}"
              AutomationProperties.Name="{Binding PreciseText}"
              Margin="0,0,8,8"/>
      <Button x:Name="BtnNv"
              Style="{DynamicResource GhostButton}"
              Content="{Binding NvProbeText}"
              Click="OnNvClick"
              IsEnabled="{Binding ButtonsEnabled}"
              AutomationProperties.Name="{Binding NvProbeText}"
              Margin="0,0,8,8"/>
      <Button x:Name="BtnAmd"
              Style="{DynamicResource GhostButton}"
              Content="{Binding AmdProbeText}"
              Click="OnAmdClick"
              IsEnabled="{Binding ButtonsEnabled}"
              AutomationProperties.Name="{Binding AmdProbeText}"
              Margin="0,0,8,8"/>
    </WrapPanel>

    <Grid Grid.Row="2" Margin="0,0,0,14">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Visible"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding StatusText}" Value="">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Border Style="{DynamicResource StatusBanner}"
              Padding="12,8"
              AutomationProperties.Name="体检状态">
        <TextBlock Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"/>
      </Border>
    </Grid>

    <Grid Grid.Row="3">
      <Border x:Name="IdlePanel"
              Style="{DynamicResource SettingsGroup}"
              Padding="28"
              Visibility="Collapsed"
              IsHitTestVisible="False">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="{Binding IdleTitle}"
                     FontSize="{DynamicResource FontSizeTitle}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Margin="0,0,0,8"/>
          <TextBlock Text="{Binding IdleHint}"
                     FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="440"
                     Margin="0,0,0,20"/>
          <Button x:Name="BtnStart"
                  Style="{DynamicResource PrimaryButton}"
                  Content="{Binding StartButtonText}"
                  Click="OnStartClick"
                  Padding="20,8"
                  HorizontalAlignment="Center"
                  AutomationProperties.Name="{Binding StartButtonText}"/>
        </StackPanel>
      </Border>

      <Border x:Name="ScanningPanel"
              Style="{DynamicResource SettingsGroup}"
              Padding="28"
              Visibility="Collapsed"
              IsHitTestVisible="False">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="520">
          <TextBlock Text="{Binding PhaseText}"
                     FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ModeAccentBrush}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Margin="0,0,0,14"/>
          <ProgressBar Value="{Binding Progress}"
                       Maximum="1"
                       Minimum="0"
                       Height="6"
                       AutomationProperties.Name="体检进度"/>
        </StackPanel>
      </Border>

      <ScrollViewer x:Name="ResultPanel"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
        <StackPanel Margin="0,0,0,16">
          <UniformGrid Columns="4" Margin="0,0,0,20">
            <Border Style="{DynamicResource MetricPanel}" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="{Binding CapabilityRows.Count}"
                           Style="{DynamicResource MetricNumber}"/>
                <TextBlock Text="{Binding CapabilityTitle}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource MetricPanel}" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="{Binding MachineRows.Count}"
                           Style="{DynamicResource MetricNumber}"/>
                <TextBlock Text="{Binding MachineTitle}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource MetricPanel}" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="{Binding PersistentRows.Count}"
                           Style="{DynamicResource MetricNumber}"/>
                <TextBlock Text="{Binding PersistentTitle}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource MetricPanel}">
              <StackPanel>
                <TextBlock Text="{Binding VerdictRows.Count}"
                           Style="{DynamicResource MetricNumber}"/>
                <TextBlock Text="{Binding VerdictTitle}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <TextBlock Text="{Binding CapabilityTitle}"
                     FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Margin="0,0,0,8"/>
          <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,18">
            <ItemsControl ItemsSource="{Binding CapabilityRows}"
                          ItemTemplate="{StaticResource AuditResultRowTemplate}"/>
          </Border>

          <TextBlock Text="{Binding MachineTitle}"
                     FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Margin="0,0,0,8"/>
          <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,18">
            <ItemsControl ItemsSource="{Binding MachineRows}"
                          ItemTemplate="{StaticResource AuditResultRowTemplate}"/>
          </Border>

          <TextBlock Text="{Binding PersistentTitle}"
                     FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Margin="0,0,0,8"/>
          <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,18">
            <ItemsControl ItemsSource="{Binding PersistentRows}"
                          ItemTemplate="{StaticResource AuditResultRowTemplate}"/>
          </Border>

          <TextBlock Text="{Binding VerdictTitle}"
                     FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Margin="0,0,0,8"/>
          <Border Style="{DynamicResource SettingsGroup}">
            <ItemsControl ItemsSource="{Binding VerdictRows}"
                          ItemTemplate="{StaticResource AuditResultRowTemplate}"/>
          </Border>

          <TextBlock Text="{Binding FooterText}"
                     FontSize="10"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     TextWrapping="Wrap"
                     Margin="4,12,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
