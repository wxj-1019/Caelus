<UserControl x:Class="CaelusApp.WpfHost.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CaelusApp.WpfHost.Controls"
             xmlns:local="clr-namespace:CaelusApp.WpfHost"
             AutomationProperties.Name="系统体检">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <DataTemplate x:Key="AuditResultRowTemplate">
      <Border Style="{DynamicResource ResultRow}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*" MinWidth="120"/>
            <ColumnDefinition Width="3*" MinWidth="160"/>
          </Grid.ColumnDefinitions>

          <!-- 分类点：警告项琥珀，否则 Accent -->
          <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,14,0" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Warn}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>

          <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Evidence}"
                       FontSize="{DynamicResource FontSizeXs}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Value}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Warn}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Note}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{Binding PageTitle}" Style="{DynamicResource PageHeader}"/>
      <TextBlock Text="{Binding PageSub}"
                 Style="{DynamicResource PageSubtitle}"
                 Margin="0,4,0,0"/>
    </StackPanel>

    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
      <WrapPanel.Style>
        <Style TargetType="WrapPanel">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers><DataTrigger Binding="{Binding ShowResultTools}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
      </WrapPanel.Style>
      <Button x:Name="BtnQuick" Style="{DynamicResource PrimaryButton}" Content="{Binding QuickText}" Click="OnQuickClick" IsEnabled="{Binding ButtonsEnabled}" AutomationProperties.Name="{Binding QuickText}" Margin="0,0,8,8"/>
      <Button x:Name="BtnPrecise" Style="{DynamicResource GhostButton}" Content="{Binding PreciseText}" Click="OnPreciseClick" IsEnabled="{Binding ButtonsEnabled}" AutomationProperties.Name="{Binding PreciseText}" Margin="0,0,8,8"/>
      <StackPanel Margin="0,0,8,8"><Button x:Name="BtnNv" Style="{DynamicResource GhostButton}" Content="{Binding NvProbeText}" Click="OnNvClick" IsEnabled="{Binding NvProbeEnabled}" AutomationProperties.Name="{Binding NvProbeText}"/><TextBlock Text="{Binding NvUnavailableReason}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" MaxWidth="180" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NvAvailable}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
      <StackPanel Margin="0,0,8,8"><Button x:Name="BtnAmd" Style="{DynamicResource GhostButton}" Content="{Binding AmdProbeText}" Click="OnAmdClick" IsEnabled="{Binding AmdProbeEnabled}" AutomationProperties.Name="{Binding AmdProbeText}"/><TextBlock Text="{Binding AmdUnavailableReason}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" MaxWidth="180" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding AmdAvailable}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
    </WrapPanel>

    <Grid Grid.Row="2" Margin="0,0,0,14">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Visible"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding StatusText}" Value="">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Border Style="{DynamicResource StatusBanner}"
              Padding="12,8"
              AutomationProperties.Name="体检状态">
        <TextBlock Text="{Binding StatusText}"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="{Binding StatusText}"/>
      </Border>
    </Grid>

    <Grid Grid.Row="3">
      <Border x:Name="IdlePanel"
              Style="{DynamicResource SettingsGroup}"
              Padding="28"
              Visibility="Collapsed"
              IsHitTestVisible="False">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="{Binding IdleTitle}"
                     FontSize="{DynamicResource FontSizeEmpty}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Margin="0,0,0,8"/>
          <TextBlock Text="{Binding IdleHint}"
                     FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="440"
                     Margin="0,0,0,16"/>
          <Button x:Name="BtnStart"
                  Style="{DynamicResource PrimaryButton}"
                  Content="{Binding StartButtonText}"
                  Click="OnStartClick"
                  Padding="20,8"
                  HorizontalAlignment="Center"
                  AutomationProperties.Name="{Binding StartButtonText}"/>
        </StackPanel>
      </Border>

      <Border x:Name="ScanningPanel"
              Style="{DynamicResource SettingsGroup}"
              Padding="28"
              Visibility="Collapsed"
              IsHitTestVisible="False">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="520">
          <!-- 圆形进度环 + 中心百分比 + 阶段叠加 -->
          <Grid HorizontalAlignment="Center" Width="120" Height="120" Margin="0,0,0,16">
            <controls:ProgressRing Progress="{Binding Progress}"
                                   Stroke="{DynamicResource ModeAccentBrush}"
                                   AutomationProperties.Name="体检进度"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="{Binding Progress, StringFormat=P0, Mode=OneWay}"
                         FontSize="{DynamicResource FontSizeSection}" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Typography.NumeralAlignment="Tabular"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="扫描中" FontSize="{DynamicResource FontSizeXs}"
                         Foreground="{DynamicResource ModeAccentBrush}"
                         HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding PhaseText}"
                     FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ModeAccentBrush}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <ScrollViewer x:Name="ResultPanel"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
        <StackPanel Margin="0,0,0,16">
          <!-- 健康摘要：评分 + 等级 + 关注项 + 上次体检 -->
          <Border x:Name="ZoneHealth" Style="{DynamicResource StatusBanner}"
                  Padding="14,12" Margin="0,0,0,16"
                  AutomationProperties.Name="体检健康摘要">
            <StackPanel>
              <WrapPanel>
              <TextBlock Text="{Binding Score, Mode=OneWay}" FontSize="{DynamicResource FontSizeScore}" FontWeight="SemiBold"
                         VerticalAlignment="Center" Typography.NumeralAlignment="Tabular">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCaution}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Margin="8,0,0,0" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="{Binding HealthLabel, Mode=OneWay}"/>
              <Rectangle Width="1" Height="28" Margin="16,0" VerticalAlignment="Center"
                         Fill="{DynamicResource BorderSubtleBrush}"/>
              <Ellipse Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCaution}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}">
                <Run Text="{Binding ConcernCount, Mode=OneWay}"/><Run Text=" 项需关注" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </TextBlock>
              <TextBlock Text="{Binding LastCheckText, Mode=OneWay}" Margin="14,0,0,0"
                         FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextTertiaryBrush}"/>
              </WrapPanel>
              <TextBlock Text="{Binding ScoreMethodText}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <UniformGrid x:Name="ZoneMetrics" Columns="2" Margin="0,0,-8,16">
            <Border Style="{DynamicResource MetricPanel}" Margin="0,0,8,8">
              <StackPanel>
                <TextBlock Text="{Binding CapabilityRows.Count}"
                           Style="{DynamicResource MetricNumber}"/>
                <TextBlock Text="{Binding CapabilityTitle}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource MetricPanel}" Margin="0,0,8,8">
              <StackPanel>
                <TextBlock Text="{Binding MachineRows.Count}"
                           Style="{DynamicResource MetricNumber}"/>
                <TextBlock Text="{Binding MachineTitle}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <!-- 常驻项卡：有警告时变琥珀 tint -->
            <Border Margin="0,0,8,0">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource MetricPanel}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PersistentHasWarn}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource WarningEdgeBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <TextBlock Text="{Binding PersistentRows.Count}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetricNumber}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding PersistentHasWarn}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding PersistentTitle}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <!-- 判定卡：有警告时变琥珀 tint -->
            <Border>
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource MetricPanel}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding VerdictHasWarn}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource WarningEdgeBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <TextBlock Text="{Binding VerdictRows.Count}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetricNumber}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding VerdictHasWarn}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding VerdictTitle}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <StackPanel x:Name="ZoneCapability" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Width="30" Height="30" CornerRadius="{DynamicResource RadiusSm}"
                      Background="{DynamicResource AccentSoftBrush}"
                      BorderBrush="{DynamicResource AccentEdgeBrush}" BorderThickness="1"
                      VerticalAlignment="Center" Margin="0,0,12,0">
                <Viewbox Width="16" Height="16">
                  <Path Data="M20 6L9 17l-5-5" Stroke="{DynamicResource ModeAccentBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Viewbox>
              </Border>
              <TextBlock Text="{Binding CapabilityTitle, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}"
                         FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="{DynamicResource FontSizeSmall}"
                         Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{Binding CapabilityRows.Count, Mode=OneWay}"/><Run Text=" 项"/>
              </TextBlock>
            </StackPanel>
            <Border Style="{DynamicResource SettingsGroup}">
              <ItemsControl ItemsSource="{Binding CapabilityRows}"
                            ItemTemplate="{StaticResource AuditResultRowTemplate}"/>
            </Border>
          </StackPanel>

          <StackPanel x:Name="ZoneMachine" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Width="30" Height="30" CornerRadius="{DynamicResource RadiusSm}"
                      Background="{DynamicResource AccentSoftBrush}"
                      BorderBrush="{DynamicResource AccentEdgeBrush}" BorderThickness="1"
                      VerticalAlignment="Center" Margin="0,0,12,0">
                <Viewbox Width="16" Height="16">
                  <Path Data="M3 6h18v13H3z M8 6V4h8v2" Stroke="{DynamicResource ModeAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                </Viewbox>
              </Border>
              <TextBlock Text="{Binding MachineTitle, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}"
                         FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="{DynamicResource FontSizeSmall}"
                         Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{Binding MachineRows.Count, Mode=OneWay}"/><Run Text=" 项"/>
              </TextBlock>
            </StackPanel>
            <Border Style="{DynamicResource SettingsGroup}">
              <ItemsControl ItemsSource="{Binding MachineRows}"
                            ItemTemplate="{StaticResource AuditResultRowTemplate}"/>
            </Border>
          </StackPanel>

          <StackPanel x:Name="ZonePersistent" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Width="30" Height="30" CornerRadius="{DynamicResource RadiusSm}"
                      Background="{DynamicResource AccentSoftBrush}"
                      BorderBrush="{DynamicResource AccentEdgeBrush}" BorderThickness="1"
                      VerticalAlignment="Center" Margin="0,0,12,0">
                <Viewbox Width="16" Height="16">
                  <Path Data="M4 6h16 M4 12h16 M4 18h10" Stroke="{DynamicResource ModeAccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Viewbox>
              </Border>
              <TextBlock Text="{Binding PersistentTitle, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}"
                         FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="{DynamicResource FontSizeSmall}"
                         Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{Binding PersistentRows.Count, Mode=OneWay}"/><Run Text=" 项"/>
              </TextBlock>
            </StackPanel>
            <Border Style="{DynamicResource SettingsGroup}">
              <ItemsControl ItemsSource="{Binding PersistentRows}"
                            ItemTemplate="{StaticResource AuditResultRowTemplate}"/>
            </Border>
          </StackPanel>

          <StackPanel x:Name="ZoneVerdict">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Width="30" Height="30" CornerRadius="{DynamicResource RadiusSm}"
                      Background="{DynamicResource AccentSoftBrush}"
                      BorderBrush="{DynamicResource AccentEdgeBrush}" BorderThickness="1"
                      VerticalAlignment="Center" Margin="0,0,12,0">
                <Viewbox Width="16" Height="16">
                  <Path Data="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6z" Stroke="{DynamicResource ModeAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                </Viewbox>
              </Border>
              <TextBlock Text="{Binding VerdictTitle, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}"
                         FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="{DynamicResource FontSizeSmall}"
                         Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{Binding VerdictRows.Count, Mode=OneWay}"/><Run Text=" 项"/>
              </TextBlock>
            </StackPanel>
            <Border Style="{DynamicResource SettingsGroup}">
              <ItemsControl ItemsSource="{Binding VerdictRows}"
                            ItemTemplate="{StaticResource AuditResultRowTemplate}"/>
            </Border>
          </StackPanel>

          <TextBlock Text="{Binding FooterText}"
                     FontSize="{DynamicResource FontSizeXs}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     TextWrapping="Wrap"
                     Margin="4,12,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
