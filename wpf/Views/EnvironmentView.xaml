<UserControl x:Class="CaelusApp.WpfHost.Views.EnvironmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CaelusApp.WpfHost.Controls"
             xmlns:local="clr-namespace:CaelusApp.WpfHost"
             AutomationProperties.Name="绯荤粺鐜">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <Style x:Key="EnvStateBadge" TargetType="Border" BasedOn="{StaticResource StatusBadge}">
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource SuccessEdgeBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="EnvStateText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="EnvToggleTemplate">
      <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1" local:RowToggle.Enabled="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <WrapPanel>
              <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeCaption}"
                         FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="Wrap" VerticalAlignment="Center"/>
              <Border Style="{StaticResource EnvStateBadge}" Margin="9,0,0,0">
                <TextBlock Text="{Binding StateText, Mode=OneWay}" Style="{StaticResource EnvStateText}"/>
              </Border>
              <Border Style="{DynamicResource StatusBadge}" Padding="8,2" Margin="6,0,0,0"
                      Visibility="{Binding RequiresRestart, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding RestartText}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource ModeAccentBrush}"/>
              </Border>
              <Border Style="{DynamicResource WarnTag}" Margin="6,0,0,0"
                      Visibility="{Binding IsRisky, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding RiskText}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource WarningBrush}"/>
              </Border>
              <Border>
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                    <Setter Property="Padding" Value="8,2"/>
                    <Setter Property="Margin" Value="6,0,0,0"/>
                    <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding AvailabilityText, Mode=OneWay}" FontSize="{DynamicResource FontSizeXs}"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding Desc}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding FeedbackText, Mode=OneWay}" Margin="0,5,0,0" FontSize="{DynamicResource FontSizeXs}"
                       Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding FeedbackText}" Value="">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FeedbackKind}" Value="Error">
                      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <ToggleButton Grid.Column="1" Style="{DynamicResource PolicyToggle}"
                        IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding IsEnabled}"
                        Click="OnToggleClick" AutomationProperties.Name="{Binding Title}"
                        VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">
      <StackPanel x:Name="ZoneHeader" Margin="0,0,0,16">
        <TextBlock Text="{Binding PageTitle}" Style="{DynamicResource PageHeader}"/>
        <TextBlock Text="{Binding PageSub}" Style="{DynamicResource PageSubtitle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>

      <StackPanel x:Name="ZoneGraphics" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="30" Height="30" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                  BorderThickness="1" Margin="0,0,12,0">
            <ctl:IconView Key="IconGpu" Width="16" Height="16" Foreground="{DynamicResource ModeAccentBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding GraphicsSection}" FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Style="{DynamicResource SettingsGroup}">
          <ItemsControl ItemsSource="{Binding GraphicsToggles}" ItemTemplate="{StaticResource EnvToggleTemplate}"/>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ZoneSecurity" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="30" Height="30" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningEdgeBrush}"
                  BorderThickness="1" Margin="0,0,12,0">
            <ctl:IconView Key="IconShield" Width="16" Height="16" Foreground="{DynamicResource WarningBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding SecuritySection}" FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Style="{DynamicResource SettingsGroup}">
          <ItemsControl ItemsSource="{Binding SecurityToggles}" ItemTemplate="{StaticResource EnvToggleTemplate}"/>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ZoneInterrupt" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="30" Height="30" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                  BorderThickness="1" Margin="0,0,12,0">
            <ctl:IconView Key="IconEnvironment" Width="16" Height="16" Foreground="{DynamicResource ModeAccentBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding InterruptSection}" FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Style="{DynamicResource SettingsGroup}">
          <ItemsControl ItemsSource="{Binding InterruptToggles}" ItemTemplate="{StaticResource EnvToggleTemplate}"/>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ZoneNetwork">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="30" Height="30" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                  BorderThickness="1" Margin="0,0,12,0">
            <ctl:IconView Key="IconPolicy" Width="16" Height="16" Foreground="{DynamicResource ModeAccentBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding NetworkSection}" FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Style="{DynamicResource SettingsGroup}">
          <ItemsControl ItemsSource="{Binding NetworkToggles}" ItemTemplate="{StaticResource EnvToggleTemplate}"/>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
