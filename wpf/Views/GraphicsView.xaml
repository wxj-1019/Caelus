<UserControl x:Class="CaelusApp.WpfHost.Views.GraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CaelusApp.WpfHost.Controls"
             xmlns:local="clr-namespace:CaelusApp.WpfHost">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">

      <StackPanel x:Name="ZoneHeader" Margin="0,0,0,18">
        <TextBlock Text="{Binding PageTitle}" Style="{DynamicResource PageHeader}"/>
        <TextBlock Text="{Binding PageSub}" Style="{DynamicResource PageSubtitle}" Margin="0,3,0,0"/>
      </StackPanel>

      <!-- GPU 检测 + 启用计数摘要 -->
      <Border x:Name="ZoneSummary" Style="{DynamicResource StatusBanner}"
              Padding="14,12" Margin="0,0,0,18" AutomationProperties.Name="显卡检测摘要">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding NvStatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
          <Rectangle Width="1" Height="22" Margin="16,0" VerticalAlignment="Center"
                     Fill="{DynamicResource BorderSubtleBrush}"/>
          <TextBlock FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Typography.NumeralAlignment="Tabular">
            <Run Text="{Binding EnabledCount, Mode=OneWay}"/><Run Text="/" Foreground="{DynamicResource TextTertiaryBrush}"/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
          </TextBlock>
          <TextBlock Text="项已启用" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <Rectangle Width="1" Height="22" Margin="16,0" VerticalAlignment="Center"
                     Fill="{DynamicResource BorderSubtleBrush}"/>
          <TextBlock Text="{Binding AmdStatusText, Mode=OneWay}" FontSize="11"
                     Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- ===== 分组 1：逐游戏 NV ===== -->
      <TextBlock Text="{Binding PerGameTitle}" FontSize="{DynamicResource FontSizeBody}"
                 FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
      <Border Style="{DynamicResource SettingsGroup}">
        <StackPanel>

      <!-- GPU 高性能偏好 -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding GpuHighPerf}"
                        AutomationProperties.Name="{Binding GpuTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding GpuTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding GpuNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 关闭 FSO -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding DisableFso}"
                        AutomationProperties.Name="{Binding FsoTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding FsoTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding FsoNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- NV 最高性能 -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding NvMaxPerf}"
                        IsEnabled="{Binding NvAvailable}"
                        AutomationProperties.Name="{Binding NvMaxTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding NvMaxTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding NvMaxNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- NV 低延迟 -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding NvLowLatency}"
                        IsEnabled="{Binding NvAvailable}"
                        AutomationProperties.Name="{Binding NvLowLatTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding NvLowLatTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding NvLowLatNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- NV 帧率上限（5 段）-->
      <Border Style="{DynamicResource PolicyRow}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding NvFrlTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <Border Style="{DynamicResource SegValueChip}" Margin="10,0,0,0">
              <TextBlock Text="{Binding NvFrlLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource ModeAccentBrush}"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding NvFrlNote}" FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
          <ctl:SegmentedControl ItemsSource="{Binding FrlLabels}"
                                SelectedIndex="{Binding NvFrlIndex, Mode=TwoWay}"
                                IsEnabled="{Binding NvAvailable}"
                                AutomationProperties.Name="{Binding NvFrlTitle}"
                                SelectionChanged="OnFrlChanged"/>
        </StackPanel>
      </Border>

      <!-- NV DLSS（4 段）-->
      <Border Style="{DynamicResource PolicyRow}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding NvDlssTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <Border Style="{DynamicResource SegValueChip}" Margin="10,0,0,0">
              <TextBlock Text="{Binding NvDlssLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource ModeAccentBrush}"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding NvDlssNote}" FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
          <ctl:SegmentedControl ItemsSource="{Binding DlssLabels}"
                                SelectedIndex="{Binding NvDlssIndex, Mode=TwoWay}"
                                IsEnabled="{Binding DlssAvailable}"
                                AutomationProperties.Name="{Binding NvDlssTitle}"
                                SelectionChanged="OnDlssChanged"/>
        </StackPanel>
      </Border>

      <!-- NV ReBAR -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding NvRebar}"
                        IsEnabled="{Binding NvAvailable}"
                        AutomationProperties.Name="{Binding NvRebarTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding NvRebarTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding NvRebarNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- NV Ansel -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding NvAnselOff}"
                        IsEnabled="{Binding NvAvailable}"
                        AutomationProperties.Name="{Binding NvAnselTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding NvAnselTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding NvAnselNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- NV 电池满血 -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding NvBattFull}"
                        IsEnabled="{Binding NvAvailable}"
                        AutomationProperties.Name="{Binding NvBattTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding NvBattTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding NvBattNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

        </StackPanel>
      </Border>

      <!-- ===== 分组 2：会话 ===== -->
      <TextBlock Text="{Binding SessionTitle}" FontSize="{DynamicResource FontSizeBody}"
                 FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,8"/>
      <Border Style="{DynamicResource SettingsGroup}">

      <!-- 后台硬限帧 -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding NvBgFrl}"
                        IsEnabled="{Binding NvAvailable}"
                        AutomationProperties.Name="{Binding NvBgTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding NvBgTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding NvBgNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      </Border>

      <!-- ===== 分组 3：呈现路径 ===== -->
      <TextBlock Text="{Binding PresentTitle}" FontSize="{DynamicResource FontSizeBody}"
                 FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,8"/>
      <Border Style="{DynamicResource SettingsGroup}">

      <!-- 窗口化游戏优化 -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding WindowedOpt}"
                        AutomationProperties.Name="{Binding WindowedOptTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding WindowedOptTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding WindowedOptNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      </Border>

      <!-- ===== 分组 4：AMD ===== -->
      <TextBlock Text="{Binding AmdTitle}" FontSize="{DynamicResource FontSizeBody}"
                 FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,8"/>
      <Border Style="{DynamicResource SettingsGroup}">
        <StackPanel>

      <!-- AMD Anti-Lag -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding AmdAntiLag}"
                        IsEnabled="{Binding AmdAvailable}"
                        AutomationProperties.Name="{Binding AmdAlagTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding AmdAlagTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding AmdAlagNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- AMD Chill 限帧（5 段）-->
      <Border Style="{DynamicResource PolicyRow}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding AmdChillTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <Border Style="{DynamicResource SegValueChip}" Margin="10,0,0,0">
              <TextBlock Text="{Binding AmdChillLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource ModeAccentBrush}"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding AmdChillNote}" FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
          <ctl:SegmentedControl ItemsSource="{Binding FrlLabels}"
                                SelectedIndex="{Binding AmdChillIndex, Mode=TwoWay}"
                                IsEnabled="{Binding AmdAvailable}"
                                AutomationProperties.Name="{Binding AmdChillTitle}"
                                SelectionChanged="OnAmdChillChanged"/>
        </StackPanel>
      </Border>

      <!-- AMD Enhanced Sync -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding AmdEnhSync}"
                        IsEnabled="{Binding AmdAvailable}"
                        AutomationProperties.Name="{Binding AmdEsyncTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding AmdEsyncTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding AmdEsyncNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- AMD RIS -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding AmdRis}"
                        IsEnabled="{Binding AmdAvailable}"
                        AutomationProperties.Name="{Binding AmdRisTitle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding AmdRisTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding AmdRisNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- AMD 着色器缓存重置 -->
      <Border Style="{DynamicResource PolicyRow}">
        <DockPanel>
          <Button x:Name="BtnAmdCache" Content="{Binding AmdCacheBtnText}" Click="OnAmdCache"
                  Style="{DynamicResource GhostButton}" Padding="12,4"
                  IsEnabled="{Binding AmdAvailable}"
                  AutomationProperties.Name="{Binding AmdCacheTitle}"
                  DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding AmdCacheTitle}" FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding AmdCacheNote}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
