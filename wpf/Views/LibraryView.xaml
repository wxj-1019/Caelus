<UserControl x:Class="CaelusApp.WpfHost.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CaelusApp.WpfHost"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
             AutomationProperties.Name="游戏库">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel x:Name="ZoneHeader" Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="游戏库" Style="{DynamicResource PageHeader}"/>
      <TextBlock Text="管理游戏主程序并查看当前运行状态"
                 Style="{DynamicResource PageSubtitle}" Margin="0,4,0,0"/>
    </StackPanel>

    <ContentControl x:Name="EmptyPanel" Grid.Row="1" Style="{DynamicResource DropZoneEmpty}"
            MinHeight="300" AllowDrop="True"
            AutomationProperties.Name="游戏库为空，可添加或拖放游戏"
            AutomationProperties.HelpText="将游戏主程序拖放到此区域，或使用添加游戏按钮">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  MaxWidth="440" Margin="32">
        <Border x:Name="EmptyHeroIcon" Width="48" Height="48" CornerRadius="6"
                HorizontalAlignment="Center" Margin="0,0,0,18"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentEdgeBrush}" BorderThickness="1">
          <Viewbox Width="22" Height="22">
            <Path Data="{DynamicResource IconLibrary}"
                  Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="2"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Viewbox>
        </Border>
        <TextBlock Text="添加你的第一个游戏" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock Text="{Binding EmptyHint}" Margin="0,6,0,0"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        <Button Content="{Binding AddButtonText}" Click="OnAddClick"
                Style="{DynamicResource PrimaryButton}" Padding="18,8" Margin="0,20,0,0"
                HorizontalAlignment="Center" AutomationProperties.Name="添加游戏"/>
        <Grid Margin="0,20,0,0" Width="300">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center"
                     Fill="{DynamicResource BorderSubtleBrush}"/>
          <TextBlock Grid.Column="1" Text="或拖放主程序到这里" Margin="12,0"
                     FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
          <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                     Fill="{DynamicResource BorderSubtleBrush}"/>
        </Grid>
      </StackPanel>
    </ContentControl>

    <Grid x:Name="ListPanel" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="12"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border x:Name="ZoneToolbar" Grid.Row="0" Style="{DynamicResource SettingsGroup}" Padding="0">
        <Border Style="{DynamicResource SettingsRow}" Padding="16,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <!-- 计数摘要：已纳管 N · 运行中 M（运行数 success 绿） -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock Text=" 已纳管" Margin="0,0,16,0" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Rectangle Width="1" Height="16" VerticalAlignment="Center"
                           Fill="{DynamicResource BorderSubtleBrush}"/>
                <TextBlock Text="{Binding RunningCount}" Margin="16,0,0,0" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource SuccessBrush}"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock Text=" 运行中" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <TextBlock Text="{Binding DropHint}" Margin="0,3,16,0" FontSize="10"
                         Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding AddButtonText}" Click="OnAddClick"
                    Style="{DynamicResource PrimaryButton}" Padding="14,7" Margin="8,0,0,0"
                    AutomationProperties.Name="添加游戏"/>
            <Button Grid.Column="2" x:Name="BtnRemove"
                    Content="{Binding RemoveButtonText}" Click="OnRemoveClick"
                    Style="{DynamicResource GhostButton}" Padding="12,7" Margin="6,0,0,0"
                    Foreground="{DynamicResource DangerBrush}" IsEnabled="False"
                    AutomationProperties.Name="移除所选游戏"/>
          </Grid>
        </Border>
      </Border>

      <Border x:Name="ZoneList" Grid.Row="2" Style="{DynamicResource SettingsGroup}" Padding="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="12,8,12,7">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="游戏与进程" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Grid.Column="1" Text="方向键选择 · Delete 移除" FontSize="10"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
          </Grid>

          <ListBox Grid.Row="1" x:Name="GameList" ItemsSource="{Binding Items}"
                   ItemContainerStyle="{DynamicResource ListItem}"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   KeyboardNavigation.DirectionalNavigation="Continue"
                   SelectionMode="Single" SelectionChanged="OnGameSelectionChanged"
                   PreviewKeyDown="OnGameListPreviewKeyDown"
                   AutomationProperties.Name="已添加的游戏">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource SettingsRow}" Margin="6,2" Padding="12,10"
                        local:Motion.Lift="True"
                        AutomationProperties.Name="{Binding Name}">
                  <Grid MinHeight="44">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*" MinWidth="160"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 首字母头像（视觉锚点） -->
                    <Border Grid.Column="0" Style="{DynamicResource GameAvatar}" Margin="0,0,14,0">
                      <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold"
                                 Foreground="{DynamicResource ModeAccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeCaption}"
                                 FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Path}" FontFamily="{DynamicResource FontMono}"
                                 FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"
                                 TextTrimming="CharacterEllipsis" Margin="0,4,18,0"
                                 AutomationProperties.Name="{Binding Path}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{DynamicResource StatusChip}">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                          <Ellipse.Style>
                            <Style TargetType="Ellipse">
                              <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                  <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="{Binding StatusText}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
