<UserControl x:Class="CaelusApp.WpfHost.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="运行日志">
  <Grid Margin="0,0,0,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="日志" Style="{DynamicResource PageHeader}"/>
      <TextBlock Text="运行记录与诊断" Style="{DynamicResource PageSubtitle}" Margin="0,4,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="0" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1" Padding="12,8">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="BtnOpen" Content="{Binding OpenLogText}" Click="OnOpenLog"
                      Style="{DynamicResource GhostButton}" Padding="10,5"
                      AutomationProperties.Name="打开日志文件"/>
              <Button x:Name="BtnClear" Content="{Binding ClearLogText}" Click="OnClearLog"
                      Style="{DynamicResource DangerButton}" Padding="10,5" Margin="8,0,0,0"
                      AutomationProperties.Name="清除运行日志"/>
            </StackPanel>
            <TextBlock Text="实时记录" VerticalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
          </DockPanel>
        </Border>

        <TextBox x:Name="TbLog" Grid.Row="1" IsReadOnly="True"
                 Background="Transparent" BorderThickness="0" Padding="14,12"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 FontFamily="{DynamicResource FontMono}" FontSize="12"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" Text="{Binding LogText, Mode=OneWay}"
                 AutomationProperties.Name="运行日志内容"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
