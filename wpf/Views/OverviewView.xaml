<UserControl x:Class="CaelusApp.WpfHost.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CaelusApp.WpfHost"
             xmlns:controls="clr-namespace:CaelusApp.WpfHost.Controls"
             AutomationProperties.Name="Caelus WPF 概览预览">
  <UserControl.Resources>
    <local:KeyBrushConverter x:Key="KeyBrush"/>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <local:DetailButtonTextConverter x:Key="DetailText"/>
    <local:FractionGridLengthConverter x:Key="FracLen"/>
    <CollectionViewSource x:Key="MetricsRest" Source="{Binding Metrics}" Filter="OnMetricsFilter"/>
    <!-- 占比条入场生长（Loaded 时 Motion.GrowX） -->
    <Style x:Key="BarGrowFill" TargetType="Border">
      <EventSetter Event="Loaded" Handler="OnBarLoaded"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                AutomationProperties.Name="概览预览内容">
    <StackPanel Margin="0,0,0,16">
      <StackPanel x:Name="ZoneHeader" Margin="0,0,0,16">
        <TextBlock Text="概览" Style="{DynamicResource PageHeader}"/>
        <TextBlock Text="WPF 界面预览与样例数据概览"
                   Style="{DynamicResource PageSubtitle}"
                   Margin="0,4,0,0"/>
      </StackPanel>

      <Border x:Name="ZoneBadge" Style="{DynamicResource StatusBadge}"
              Margin="0,0,0,16"
              AutomationProperties.Name="预览状态：当前显示样例数据，不代表实时遥测">
        <DockPanel>
          <TextBlock Text="仅供界面预览"
                     DockPanel.Dock="Right"
                     Margin="20,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="11"
                     Foreground="{DynamicResource TextTertiaryBrush}"/>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ReadyDot"
                     Width="7" Height="7"
                     Margin="0,0,9,0"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource AccentPrimaryBrush}"/>
            <TextBlock Text="预览模式"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="此页由 SampleOverviewSource 提供样例数据，不代表实时系统遥测。"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <controls:GlassCard x:Name="ZoneHero" Style="{DynamicResource HeroGlassCard}"
              Margin="0,0,0,16"
              AutomationProperties.Name="样例主状态与模式">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="148"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" HorizontalAlignment="Center">
            <controls:CaelusCore x:Name="CaelusCore"
                                 AutomationProperties.Name="Caelus Core 模式标识"/>
            <TextBlock Text="CAELUS CORE"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       FontSize="10"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <DockPanel Margin="0,0,0,8">
              <Border DockPanel.Dock="Right"
                      Style="{DynamicResource StatusBadge}"
                      Margin="16,0,0,0"
                      AutomationProperties.Name="当前样例模式">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="样例模式"
                             FontSize="10"
                             Foreground="{DynamicResource TextTertiaryBrush}"/>
                  <TextBlock Text="{Binding ModeText}"
                             Margin="8,0,0,0"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </StackPanel>
              </Border>
              <TextBlock Text="样例结论"
                         VerticalAlignment="Center"
                         FontSize="10"
                         Foreground="{DynamicResource TextTertiaryBrush}"/>
            </DockPanel>

            <TextBlock x:Name="ConclusionTitleText"
                       Text="{Binding ConclusionTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="{Binding ConclusionTitle}"/>
            <TextBlock Text="{Binding ConclusionDetail}"
                       Margin="0,5,0,0"
                       MaxWidth="620"
                       HorizontalAlignment="Left"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LastCheckText}"
                       Margin="0,5,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       TextWrapping="Wrap"/>

            <Button Style="{DynamicResource GhostButton}"
                    HorizontalAlignment="Left"
                    Margin="-6,8,0,0"
                    Content="{Binding DetailVisible, Converter={StaticResource DetailText}}"
                    Command="{Binding ToggleDetailCommand}"
                    AutomationProperties.Name="查看或收起样例诊断详情"/>

            <Border Margin="0,10,0,0"
                    Padding="0,10,0,0"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding DetailVisible, Converter={StaticResource BoolVis}}"
                    AutomationProperties.Name="样例诊断详情说明">
              <TextBlock Text="诊断详情尚未接入真实数据；当前区域仅演示渐进披露交互与排版状态。"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </Grid>
      </controls:GlassCard>

      <StackPanel x:Name="ZoneMetricsLabel" Margin="0,0,0,8">
        <TextBlock Text="关键指标"
                   FontSize="{DynamicResource FontSizeBody}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="以下三项均为预览数据，用于检查数字、趋势和状态样式。"
                   Margin="0,3,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>

      <Grid x:Name="ZoneMetrics" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{DynamicResource MetricPanel}"
                Padding="16"
                local:Motion.Lift="True"
                AutomationProperties.Name="GPU 温度样例指标">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
              <TextBlock Text="样例值"
                         DockPanel.Dock="Right"
                         FontSize="10"
                         Foreground="{DynamicResource TextTertiaryBrush}"/>
              <TextBlock Text="{Binding Metrics[0].Label}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </DockPanel>
            <TextBlock Grid.Row="1"
                       Text="{Binding Metrics[0].ValueText}"
                       Style="{DynamicResource MetricNumber}"
                       Margin="0,8,0,0"/>
            <controls:Sparkline Grid.Row="2"
                                Height="26"
                                Margin="0,6,0,8"
                                Values="{Binding GpuTempSeries}"
                                Stroke="{DynamicResource AccentPrimaryBrush}"
                                AutomationProperties.Name="GPU 温度样例趋势"/>
            <Grid Grid.Row="3" Height="3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Metrics[0].Fraction, Converter={StaticResource FracLen}}"/>
                <ColumnDefinition Width="{Binding Metrics[0].Fraction, Converter={StaticResource FracLen}, ConverterParameter=rest}"/>
              </Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource TrackBrush}"/>
              <Border Grid.Column="0" CornerRadius="2" Style="{StaticResource BarGrowFill}"
                      Background="{Binding Metrics[0].ColorKey, Converter={StaticResource KeyBrush}}"/>
            </Grid>
          </Grid>
        </Border>

        <ItemsControl Grid.Column="2"
                      ItemsSource="{Binding Source={StaticResource MetricsRest}}"
                      Margin="0,0,-12,0"
                      AutomationProperties.Name="其余样例指标">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{DynamicResource MetricPanel}"
                      Padding="16"
                      Margin="0,0,12,0"
                      local:Motion.Lift="True"
                      AutomationProperties.Name="{Binding Label}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <DockPanel>
                    <TextBlock Text="样例值"
                               DockPanel.Dock="Right"
                               FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding Label}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </DockPanel>
                  <TextBlock Grid.Row="1"
                             Text="{Binding ValueText}"
                             Style="{DynamicResource MetricNumber}"
                             Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="2"
                             Text="来自预览数据源"
                             Margin="0,8,0,8"
                             VerticalAlignment="Bottom"
                             FontSize="10"
                             Foreground="{DynamicResource TextTertiaryBrush}"/>
                  <Grid Grid.Row="3" Height="3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FracLen}}"/>
                      <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FracLen}, ConverterParameter=rest}"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource TrackBrush}"/>
                    <Border Grid.Column="0" CornerRadius="2" Style="{StaticResource BarGrowFill}"
                            Background="{Binding ColorKey, Converter={StaticResource KeyBrush}}"/>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <Grid x:Name="ZoneBottom">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.35*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{DynamicResource SettingsGroup}"
                Padding="12"
                AutomationProperties.Name="最近活动预览摘要">
          <StackPanel>
            <TextBlock Text="最近活动"
                       FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="活动流尚未接入；下列内容仅描述当前预览状态。"
                       Margin="0,3,0,10"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="当前模式预览"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding ModeText}"
                         FontSize="11"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Grid>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="样例数据刷新"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="1"
                         Text="仅宿主启动或切换模式时"
                         FontSize="11"
                         Foreground="{DynamicResource TextTertiaryBrush}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="真实活动记录"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ContentControl Grid.Column="1" Style="{DynamicResource EmptyChip}">
                <TextBlock Text="未接入"
                           FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"/></ContentControl>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Style="{DynamicResource SettingsGroup}"
                Padding="12"
                AutomationProperties.Name="硬件摘要预览状态">
          <StackPanel>
            <TextBlock Text="硬件摘要"
                       FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="当前 ViewModel 没有硬件型号绑定。"
                       Margin="0,3,0,10"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <DockPanel Margin="0,0,0,6">
              <ContentControl DockPanel.Dock="Right" Style="{DynamicResource EmptyChip}">
                <TextBlock Text="未绑定" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/></ContentControl>
              <TextBlock Text="处理器" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
              <ContentControl DockPanel.Dock="Right" Style="{DynamicResource EmptyChip}">
                <TextBlock Text="未绑定" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/></ContentControl>
              <TextBlock Text="图形设备" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </DockPanel>
            <DockPanel>
              <ContentControl DockPanel.Dock="Right" Style="{DynamicResource EmptyChip}">
                <TextBlock Text="未绑定" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/></ContentControl>
              <TextBlock Text="内存规格" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </DockPanel>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
