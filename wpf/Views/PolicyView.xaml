<UserControl x:Class="CaelusApp.WpfHost.Views.PolicyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CaelusApp.WpfHost.Controls"
             xmlns:local="clr-namespace:CaelusApp.WpfHost"
             AutomationProperties.Name="优化策略">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <DataTemplate x:Key="PolicyRowTemplate">
      <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1" local:RowToggle.Enabled="True">
        <DockPanel LastChildFill="True">
          <ToggleButton Style="{DynamicResource PolicyToggle}"
                        IsChecked="{Binding IsOn, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled}"
                        AutomationProperties.Name="{Binding ToggleAutomationName}"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Title}"
                         FontSize="{DynamicResource FontSizeCaption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="Wrap"/>
              <Border Style="{DynamicResource WarnTag}" Margin="8,0,0,0"
                      Visibility="{Binding IsRisky, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding WarningTag}" FontSize="{DynamicResource FontSizeXs}"
                           Foreground="{DynamicResource WarningBrush}"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Description}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"/>
            <TextBlock Text="{Binding LockNote}"
                       Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}"
                       FontSize="{DynamicResource FontSizeXs}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">
      <StackPanel x:Name="ZoneHeader" Margin="0,0,0,16">
        <TextBlock Text="优化策略" Style="{DynamicResource PageHeader}"/>
        <TextBlock Text="调度与压制的生效策略"
                   Style="{DynamicResource PageSubtitle}"
                   Margin="0,4,0,0"/>
      </StackPanel>

      <!-- 摘要使用两列 Grid；右侧说明在窄窗口中自动换行。 -->
      <Border x:Name="ZoneSummary" Style="{DynamicResource StatusBanner}"
              Padding="14,12" Margin="0,0,0,14"
              AutomationProperties.Name="{Binding SummaryAutomationName}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Typography.NumeralAlignment="Tabular">
              <Run Text="{Binding TotalEnabled, Mode=OneWay}"/><Run Text="/" Foreground="{DynamicResource TextTertiaryBrush}"/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="项已启用" Margin="8,0,0,0" FontSize="{DynamicResource FontSizeSmall}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <WrapPanel Margin="0,0,0,5">
              <Border x:Name="SummaryModeBadge" Style="{DynamicResource StatusBadge}"
                      Padding="10,3" Margin="0,0,8,3"
                      AutomationProperties.Name="{Binding ModeAutomationName}">
                <TextBlock Text="{Binding ModeBadgeText, Mode=OneWay}" FontSize="{DynamicResource FontSizeXs}"
                           FontWeight="SemiBold" Foreground="{DynamicResource ModeAccentBrush}"/>
              </Border>
              <TextBlock Text="模式预设" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
            </WrapPanel>
            <TextBlock Text="{Binding HintText, Mode=OneWay}" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 一次只展示一个策略分组，避免 21 行同时展开。 -->
      <ctl:SegmentedControl x:Name="PolicyGroupSelector"
                            ItemsSource="{Binding GroupLabels}"
                            SelectedIndex="0"
                            SelectionChanged="OnPolicyGroupChanged"
                            AutomationProperties.Name="策略分组筛选"
                            Margin="0,0,0,16"/>

      <Grid x:Name="ZoneGroups">
        <StackPanel x:Name="ZoneCore">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding CoreGroupTitle}" FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextSecondaryBrush}">
              <Run Text="{Binding CoreEnabled, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/><Run Text="/"/><Run Text="{Binding CoreTotal, Mode=OneWay}"/><Run Text=" 项已启用"/>
            </TextBlock>
          </StackPanel>
          <Border Style="{DynamicResource SettingsGroup}">
            <ItemsControl ItemsSource="{Binding CoreCards}" ItemTemplate="{StaticResource PolicyRowTemplate}"/>
          </Border>
        </StackPanel>

        <StackPanel x:Name="ZoneCustom" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding CustomGroupTitle}" FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextSecondaryBrush}">
              <Run Text="{Binding CustomEnabled, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/><Run Text="/"/><Run Text="{Binding CustomTotal, Mode=OneWay}"/><Run Text=" 项已启用"/>
            </TextBlock>
          </StackPanel>
          <Border Style="{DynamicResource SettingsGroup}">
            <ItemsControl ItemsSource="{Binding CustomCards}" ItemTemplate="{StaticResource PolicyRowTemplate}"/>
          </Border>
        </StackPanel>

        <StackPanel x:Name="ZoneExtra" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding ExtraGroupTitle}" FontSize="{DynamicResource FontSizeBody}"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextSecondaryBrush}">
              <Run Text="{Binding ExtraEnabled, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/><Run Text="/"/><Run Text="{Binding ExtraTotal, Mode=OneWay}"/><Run Text=" 项已启用"/>
            </TextBlock>
          </StackPanel>
          <Border Style="{DynamicResource SettingsGroup}">
            <ItemsControl ItemsSource="{Binding ExtraCards}" ItemTemplate="{StaticResource PolicyRowTemplate}"/>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
