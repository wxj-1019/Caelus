<UserControl x:Class="CaelusApp.WpfHost.Views.PolicyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="优化策略">
  <UserControl.Resources>
    <DataTemplate x:Key="PolicyRowTemplate">
      <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1">
        <DockPanel>
          <ToggleButton Style="{DynamicResource PolicyToggle}"
                        IsChecked="{Binding IsOn}"
                        IsEnabled="{Binding IsEnabled}"
                        AutomationProperties.Name="{Binding Title}"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Description}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">
      <StackPanel Margin="0,0,0,16">
        <TextBlock Text="优化策略" Style="{DynamicResource PageHeader}"/>
        <TextBlock Text="调度与压制的生效策略"
                   Style="{DynamicResource PageSubtitle}"
                   Margin="0,4,0,0"/>
      </StackPanel>

      <Border Style="{DynamicResource StatusBanner}"
              Padding="12,8"
              Margin="0,0,0,18"
              AutomationProperties.Name="策略状态">
        <TextBlock Text="{Binding HintText}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"/>
      </Border>

      <TextBlock Text="{Binding CoreGroupTitle}"
                 FontSize="{DynamicResource FontSizeBody}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Margin="0,0,0,8"/>
      <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,18">
        <ItemsControl ItemsSource="{Binding CoreCards}"
                      ItemTemplate="{StaticResource PolicyRowTemplate}"/>
      </Border>

      <TextBlock Text="{Binding CustomGroupTitle}"
                 FontSize="{DynamicResource FontSizeBody}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Margin="0,0,0,8"/>
      <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,18">
        <ItemsControl ItemsSource="{Binding CustomCards}"
                      ItemTemplate="{StaticResource PolicyRowTemplate}"/>
      </Border>

      <TextBlock Text="{Binding ExtraGroupTitle}"
                 FontSize="{DynamicResource FontSizeBody}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Margin="0,0,0,8"/>
      <Border Style="{DynamicResource SettingsGroup}">
        <ItemsControl ItemsSource="{Binding ExtraCards}"
                      ItemTemplate="{StaticResource PolicyRowTemplate}"/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
