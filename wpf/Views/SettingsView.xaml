<UserControl x:Class="CaelusApp.WpfHost.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CaelusApp.WpfHost"
             AutomationProperties.Name="设置">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">
      <StackPanel x:Name="ZoneHeader" Margin="0,0,0,16">
        <TextBlock Text="设置" Style="{DynamicResource PageHeader}"/>
        <TextBlock Text="偏好、开发选项与维护工具" Style="{DynamicResource PageSubtitle}" Margin="0,4,0,0"/>
      </StackPanel>

      <Border x:Name="ZoneSummary" Style="{DynamicResource StatusBanner}" Margin="0,0,0,16" Padding="14,11">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="当前偏好" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding PreferenceSummary}" Margin="0,3,0,0" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{DynamicResource NeutralStatusBadge}" VerticalAlignment="Center" Margin="16,0,0,0">
            <TextBlock Text="{Binding DevSummary}" MaxWidth="340" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>

      <Border x:Name="PageFeedbackBanner" Margin="0,0,0,16">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource StatusBanner}">
            <Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource InfoEdgeBrush}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding PageFeedback}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              <DataTrigger Binding="{Binding PageFeedbackKind}" Value="Success"><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SuccessEdgeBrush}"/></DataTrigger>
              <DataTrigger Binding="{Binding PageFeedbackKind}" Value="Warning"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningEdgeBrush}"/></DataTrigger>
              <DataTrigger Binding="{Binding PageFeedbackKind}" Value="Error"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerEdgeBrush}"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding PageFeedback}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
      </Border>

      <StackPanel x:Name="ZoneApp">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="28" Height="28" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                  BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <Viewbox Width="15" Height="15">
              <Path Data="M3 12a9 9 0 1 1 18 0 9 9 0 1 1-18 0 M12 5v2 M12 17v2 M5 12h2 M17 12h2"
                    Stroke="{DynamicResource ModeAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Viewbox>
          </Border>
          <TextBlock Text="{Binding AppSectionTitle}" FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="启动、窗口和外观偏好会立即保存。" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
        <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,16">
          <StackPanel>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1" local:RowToggle.Enabled="True"><DockPanel><ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding AutoStart}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="开机自启"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding AutoStartTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding AutoStartNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1" local:RowToggle.Enabled="True"><DockPanel><ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding AutoHide}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="游戏启动后自动收起"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding AutoHideTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding AutoHideNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" local:RowToggle.Enabled="True"><DockPanel><ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding LightMode}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="亮色主题"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding LightModeTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding LightModeNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ZoneDev">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="28" Height="28" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                  BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <Viewbox Width="15" Height="15">
              <Path Data="M9.5 2L2 9.5 4.5 12l5-5 2.5 2.5L22 2z M2 22h20"
                    Stroke="{DynamicResource ModeAccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Viewbox>
          </Border>
          <TextBlock Text="开发" FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="仅在调试自定义构建识别时启用。" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
        <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,16">
          <StackPanel>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1" local:RowToggle.Enabled="True"><DockPanel><ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding DevMode}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="开发模式"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DevModeTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding DevModeNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" IsEnabled="{Binding IsDevCustomEnabled}"><StackPanel><DockPanel Margin="0,0,0,8"><Button x:Name="BtnDevSave" Content="{Binding DevCustomSaveText}" Click="OnDevSave" Style="{DynamicResource GhostButton}" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="保存自定义编译进程"/><TextBlock Text="{Binding DevCustomTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="TbDevCustom" Text="{Binding DevCustomInitial, Mode=OneTime}" Style="{DynamicResource InputBox}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="48" MaxHeight="112" FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSizeMono}" AutomationProperties.Name="自定义编译进程列表"/><TextBlock Text="{Binding DevCustomNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ZoneMaint">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="28" Height="28" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                  BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <Viewbox Width="15" Height="15">
              <Path Data="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6z"
                    Stroke="{DynamicResource ModeAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Viewbox>
          </Border>
          <TextBlock Text="{Binding MaintSectionTitle}" FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="维护操作保持原有范围，执行状态会显示在当前页面。" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
        <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,16">
          <StackPanel>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><DockPanel><Button x:Name="BtnDefender" Content="{Binding DefenderText}" Click="OnDefender" Style="{DynamicResource GhostButton}" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="打开 Defender 排除说明"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DefenderTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding DefenderDesc}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><DockPanel><Button x:Name="BtnAddon" Content="{Binding AddonText}" Click="OnAddon" Style="{DynamicResource GhostButton}" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="打开英雄联盟附加层说明"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding AddonTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding AddonDesc}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}"><DockPanel><Button x:Name="BtnShader" Content="{Binding ShaderText}" Click="OnShader" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="清理着色器缓存"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Style.Triggers><DataTrigger Binding="{Binding IsShaderBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ShaderTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><ProgressBar Width="72" Height="3" IsIndeterminate="True" Margin="0,0,8,0"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsShaderBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock x:Name="LblShaderStatus" Text="{Binding ShaderStatus}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.Name="着色器缓存状态"/></StackPanel></StackPanel></DockPanel></Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ZoneDanger">
        <TextBlock Text="危险区" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,3"/>
        <TextBlock Text="操作前会再次确认，并尝试恢复所有已记录项。" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
        <Border Style="{DynamicResource SettingsGroup}"><Border Style="{DynamicResource PolicyRow}"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><ProgressBar Width="72" Height="3" IsIndeterminate="True" Margin="0,0,10,0"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRestoreBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><Button x:Name="BtnRestore" Content="{Binding RestoreText}" Click="OnRestore" Padding="12,6" AutomationProperties.Name="恢复所有已记录的系统项"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DangerButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRestoreBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding RestoreTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding RestoreDesc}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border></Border>
      </StackPanel>

      <TextBlock Text="{Binding AboutText}" FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,12,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
