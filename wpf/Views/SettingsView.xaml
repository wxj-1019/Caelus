<UserControl x:Class="CaelusApp.WpfHost.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="设置">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">
      <StackPanel Margin="0,0,0,16">
        <TextBlock Text="设置" Style="{DynamicResource PageHeader}"/>
        <TextBlock Text="偏好、开发选项与维护工具" Style="{DynamicResource PageSubtitle}" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- 应用行为 -->
      <TextBlock Text="应用行为" FontSize="{DynamicResource FontSizeBody}"
                 FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                 Margin="0,0,0,8"/>
      <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,20">
        <StackPanel>
          <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1">
            <DockPanel>
              <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding AutoStart}"
                            DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                            AutomationProperties.Name="开机自启"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding AutoStartTitle}" FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding AutoStartNote}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1">
            <DockPanel>
              <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding AutoHide}"
                            DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                            AutomationProperties.Name="游戏启动后自动收起"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding AutoHideTitle}" FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding AutoHideNote}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{DynamicResource SettingsRow}">
            <DockPanel>
              <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding LightMode}"
                            DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                            AutomationProperties.Name="亮色主题"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding LightModeTitle}" FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding LightModeNote}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 开发 -->
      <TextBlock Text="开发" FontSize="{DynamicResource FontSizeBody}"
                 FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                 Margin="0,0,0,8"/>
      <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,20">
        <StackPanel>
          <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1">
            <DockPanel>
              <ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding DevMode}"
                            DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                            AutomationProperties.Name="开发模式"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DevModeTitle}" FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding DevModeNote}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{DynamicResource SettingsRow}">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Button x:Name="BtnDevSave" Content="{Binding DevCustomSaveText}" Click="OnDevSave"
                        Style="{DynamicResource GhostButton}" Padding="10,5"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                        AutomationProperties.Name="保存自定义编译进程"/>
                <TextBlock Text="{Binding DevCustomTitle}" FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
              </DockPanel>
              <TextBox x:Name="TbDevCustom" Text="{Binding DevCustomInitial, Mode=OneTime}"
                       Style="{DynamicResource InputBox}" TextWrapping="Wrap" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" MinHeight="48" MaxHeight="112"
                       FontFamily="{DynamicResource FontMono}" FontSize="12"
                       AutomationProperties.Name="自定义编译进程列表"/>
              <TextBlock Text="{Binding DevCustomNote}" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 维护 -->
      <TextBlock Text="{Binding MaintSectionTitle}" FontSize="{DynamicResource FontSizeBody}"
                 FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                 Margin="0,0,0,8"/>
      <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,20">
        <StackPanel>
          <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Button x:Name="BtnDefender" Content="{Binding DefenderText}" Click="OnDefender"
                      Style="{DynamicResource GhostButton}" Padding="10,5"
                      DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                      AutomationProperties.Name="打开 Defender 排除说明"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DefenderTitle}" FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding DefenderDesc}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{DynamicResource SettingsRow}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Button x:Name="BtnAddon" Content="{Binding AddonText}" Click="OnAddon"
                      Style="{DynamicResource GhostButton}" Padding="10,5"
                      DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                      AutomationProperties.Name="打开英雄联盟附加层说明"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding AddonTitle}" FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding AddonDesc}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{DynamicResource SettingsRow}">
            <DockPanel>
              <Button x:Name="BtnShader" Content="{Binding ShaderText}" Click="OnShader"
                      Style="{DynamicResource GhostButton}" Padding="10,5"
                      DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                      AutomationProperties.Name="清理着色器缓存"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ShaderTitle}" FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="LblShaderStatus" Text="{Binding ShaderStatus}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                           AutomationProperties.Name="着色器缓存状态"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 危险区 -->
      <TextBlock Text="危险区" FontSize="{DynamicResource FontSizeBody}"
                 FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"
                 Margin="0,0,0,8"/>
      <Border Style="{DynamicResource SettingsGroup}">
        <Border Style="{DynamicResource SettingsRow}">
          <DockPanel>
            <Button x:Name="BtnRestore" Content="{Binding RestoreText}" Click="OnRestore"
                    Style="{DynamicResource DangerButton}" Padding="12,6"
                    DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                    AutomationProperties.Name="恢复所有已记录的系统项"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding RestoreTitle}" FontSize="{DynamicResource FontSizeCaption}"
                         FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Text="{Binding RestoreDesc}" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </Border>

      <TextBlock Text="{Binding AboutText}" FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,12,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
