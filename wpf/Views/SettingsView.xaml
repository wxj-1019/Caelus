<UserControl x:Class="CaelusApp.WpfHost.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CaelusApp.WpfHost.Controls"
             xmlns:local="clr-namespace:CaelusApp.WpfHost"
             AutomationProperties.Name="设置">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">
      <StackPanel x:Name="ZoneHeader" Margin="0,0,0,16">
        <TextBlock Text="设置" Style="{DynamicResource PageHeader}"/>
        <TextBlock Text="三场景开关、应用偏好与维护工具" Style="{DynamicResource PageSubtitle}" Margin="0,4,0,0"/>
      </StackPanel>

      <Border x:Name="ZoneSummary" Style="{DynamicResource StatusBanner}" Margin="0,0,0,16" Padding="14,11">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="当前偏好" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding PreferenceSummary}" Margin="0,3,0,0" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{DynamicResource NeutralStatusBadge}" VerticalAlignment="Center" Margin="16,0,0,0">
            <TextBlock Text="{Binding DevSummary}" MaxWidth="340" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>

      <Border x:Name="PageFeedbackBanner" Margin="0,0,0,16">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource StatusBanner}">
            <Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource InfoEdgeBrush}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding PageFeedback}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              <DataTrigger Binding="{Binding PageFeedbackKind}" Value="Success"><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SuccessEdgeBrush}"/></DataTrigger>
              <DataTrigger Binding="{Binding PageFeedbackKind}" Value="Warning"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningEdgeBrush}"/></DataTrigger>
              <DataTrigger Binding="{Binding PageFeedbackKind}" Value="Error"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerEdgeBrush}"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding PageFeedback}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
      </Border>

      <StackPanel x:Name="ZoneApp">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="28" Height="28" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                  BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <Viewbox Width="15" Height="15">
              <Path Data="M3 12a9 9 0 1 1 18 0 9 9 0 1 1-18 0 M12 5v2 M12 17v2 M5 12h2 M17 12h2"
                    Stroke="{DynamicResource ModeAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Viewbox>
          </Border>
          <TextBlock Text="{Binding AppSectionTitle}" FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="启动、窗口和外观偏好会立即保存。" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
        <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,16">
          <StackPanel>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1" local:RowToggle.Enabled="True"><DockPanel><ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding AutoStart}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="开机自启"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding AutoStartTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding AutoStartNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1" local:RowToggle.Enabled="True"><DockPanel><ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding AutoHide}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="游戏启动后自动收起"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding AutoHideTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding AutoHideNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" local:RowToggle.Enabled="True"><DockPanel><ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding LightMode}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="亮色主题"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding LightModeTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding LightModeNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ZoneDev">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="28" Height="28" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                  BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <Viewbox Width="15" Height="15">
              <Path Data="M9.5 2L2 9.5 4.5 12l5-5 2.5 2.5L22 2z M2 22h20"
                    Stroke="{DynamicResource ModeAccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Viewbox>
          </Border>
          <TextBlock Text="开发" FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="编译提速、专注免打扰与开发服务守护。" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
        <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,16">
          <StackPanel>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1" local:RowToggle.Enabled="True"><DockPanel><ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding DevMode}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="开发模式"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DevModeTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding DevModeNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1" local:RowToggle.Enabled="True"><DockPanel><ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding FocusMode}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="专注模式"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding FocusModeTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding FocusModeNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1" local:RowToggle.Enabled="True"><DockPanel><ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding IdeOn}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="IDE 优化"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding IdeTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding IdeNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding FocusStatsText}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.Name="今日专注时长统计"/></StackPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><StackPanel><DockPanel Margin="0,0,0,8"><Button x:Name="BtnDistractSave" Content="{Binding DevCustomSaveText}" Click="OnDistractSave" Style="{DynamicResource GhostButton}" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="保存分心应用清单"/><TextBlock Text="{Binding DistractTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="TbDistract" Text="{Binding DistractInitial, Mode=OneTime}" Style="{DynamicResource InputBox}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="44" MaxHeight="96" FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSizeMono}" AutomationProperties.Name="分心应用清单"/><TextBlock Text="{Binding DistractNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><StackPanel><DockPanel Margin="0,0,0,8"><Button x:Name="BtnDevSvcSave" Content="{Binding DevCustomSaveText}" Click="OnDevSvcSave" Style="{DynamicResource GhostButton}" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="保存开发服务守护清单"/><TextBlock Text="{Binding DevSvcTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="TbDevSvc" Text="{Binding DevSvcInitial, Mode=OneTime}" Style="{DynamicResource InputBox}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="44" MaxHeight="96" FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSizeMono}" AutomationProperties.Name="开发服务守护清单"/><TextBlock Text="{Binding DevSvcNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><StackPanel><DockPanel Margin="0,0,0,8"><Button x:Name="BtnDevEnvRun" Content="{Binding DevEnvRunText}" Click="OnDevEnvRun" Style="{DynamicResource GhostButton}" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="检测开发环境"/><TextBlock Text="{Binding DevEnvTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding DevEnvNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBox Text="{Binding DevEnvResult, Mode=OneWay}" Style="{DynamicResource InputBox}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="180" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSizeMono}" AutomationProperties.Name="开发环境体检结果"/></StackPanel></Border>
            <Border Style="{DynamicResource PolicyRow}"><StackPanel><DockPanel Margin="0,0,0,8"><Button x:Name="BtnDevSave" Content="{Binding DevCustomSaveText}" Click="OnDevSave" Style="{DynamicResource GhostButton}" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="保存自定义编译进程"/><TextBlock Text="{Binding DevCustomTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="TbDevCustom" Text="{Binding DevCustomInitial, Mode=OneTime}" Style="{DynamicResource InputBox}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="48" MaxHeight="112" FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSizeMono}" AutomationProperties.Name="自定义编译进程列表"/><TextBlock Text="{Binding DevCustomNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ZoneDaily">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="28" Height="28" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                  BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <Viewbox Width="15" Height="15">
              <Path Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 4v4l3 3"
                    Stroke="{DynamicResource ModeAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Viewbox>
          </Border>
          <TextBlock Text="{Binding DailySectionTitle}" FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="浏览器/Office/会议软件活跃时自动压制后台。" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
        <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,16">
          <StackPanel>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1" local:RowToggle.Enabled="True"><DockPanel><ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding DailyCare}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="日常场景调度"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DailyCareTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding DailyCareNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1" local:RowToggle.Enabled="True"><DockPanel><ToggleButton Style="{DynamicResource PolicyToggle}" IsChecked="{Binding BatteryOn}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="电池供电增强"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding BatteryTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding BatteryNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><StackPanel><DockPanel Margin="0,0,0,8"><Button x:Name="BtnHealthFreqSave" Content="{Binding DevCustomSaveText}" Click="OnHealthFreqSave" Style="{DynamicResource GhostButton}" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="保存健康维护频率"/><TextBlock Text="{Binding HealthFreqTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="TbHealthFreq" Text="{Binding HealthFreqInitial, Mode=OneTime}" Style="{DynamicResource InputBox}" Width="120" HorizontalAlignment="Left" Padding="10,5" FontSize="{DynamicResource FontSizeMono}" AutomationProperties.Name="健康维护频率（天）"/><TextBlock Text="{Binding HealthFreqNote}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{DynamicResource PolicyRow}"><StackPanel><TextBlock Text="{Binding StartupNewsTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding StartupNews}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ZoneTheme">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="28" Height="28" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                  BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <ctl:IconView Key="IconSettings" Width="15" Height="15"
                          Foreground="{DynamicResource ModeAccentBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding ThemeSectionTitle}" FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{Binding ThemeSectionNote}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
        <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,16">
          <StackPanel>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Text="{Binding ToneModeTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <ctl:SegmentedControl x:Name="TonePicker" HorizontalAlignment="Left" SelectedIndex="0"
                                       SelectionChanged="OnToneModeChanged" AutomationProperties.Name="深浅模式"/>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="常规 · 强调色" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <Button Content="重置" DockPanel.Dock="Right" Click="OnAccentResetStandard" Style="{DynamicResource GhostButton}" Padding="8,4" Margin="16,0,0,0" AutomationProperties.Name="重置常规强调色"/>
                </DockPanel>
                <StackPanel x:Name="SwatchStandard" Orientation="Horizontal" Margin="0,8,0,0"/>
                <DockPanel Margin="0,8,0,0">
                  <Button Content="应用" DockPanel.Dock="Right" Click="OnAccentSaveStandard" Style="{DynamicResource GhostButton}" Padding="8,4" Margin="8,0,0,0" AutomationProperties.Name="应用自定义常规强调色"/>
                  <TextBox x:Name="HexStandard" Style="{DynamicResource InputBox}" Padding="8,4" Width="120" FontSize="{DynamicResource FontSizeMono}" AutomationProperties.Name="常规强调色 hex"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="竞技 · 强调色" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <Button Content="重置" DockPanel.Dock="Right" Click="OnAccentResetCompetitive" Style="{DynamicResource GhostButton}" Padding="8,4" Margin="16,0,0,0" AutomationProperties.Name="重置竞技强调色"/>
                </DockPanel>
                <StackPanel x:Name="SwatchCompetitive" Orientation="Horizontal" Margin="0,8,0,0"/>
                <DockPanel Margin="0,8,0,0">
                  <Button Content="应用" DockPanel.Dock="Right" Click="OnAccentSaveCompetitive" Style="{DynamicResource GhostButton}" Padding="8,4" Margin="8,0,0,0" AutomationProperties.Name="应用自定义竞技强调色"/>
                  <TextBox x:Name="HexCompetitive" Style="{DynamicResource InputBox}" Padding="8,4" Width="120" FontSize="{DynamicResource FontSizeMono}" AutomationProperties.Name="竞技强调色 hex"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource PolicyRow}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="自定义 · 强调色" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <Button Content="重置" DockPanel.Dock="Right" Click="OnAccentResetCustom" Style="{DynamicResource GhostButton}" Padding="8,4" Margin="16,0,0,0" AutomationProperties.Name="重置自定义强调色"/>
                </DockPanel>
                <StackPanel x:Name="SwatchCustom" Orientation="Horizontal" Margin="0,8,0,0"/>
                <DockPanel Margin="0,8,0,0">
                  <Button Content="应用" DockPanel.Dock="Right" Click="OnAccentSaveCustom" Style="{DynamicResource GhostButton}" Padding="8,4" Margin="8,0,0,0" AutomationProperties.Name="应用自定义自定义强调色"/>
                  <TextBox x:Name="HexCustom" Style="{DynamicResource InputBox}" Padding="8,4" Width="120" FontSize="{DynamicResource FontSizeMono}" AutomationProperties.Name="自定义强调色 hex"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource PolicyRow}">
              <StackPanel>
                <Button Content="恢复默认配色（靛蓝/蜜桃橙/暗金）" Click="OnAccentResetAll" Style="{DynamicResource GhostButton}" Padding="10,5" AutomationProperties.Name="恢复三模式默认配色"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ZoneMaint">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="28" Height="28" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                  BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <Viewbox Width="15" Height="15">
              <Path Data="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6z"
                    Stroke="{DynamicResource ModeAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Viewbox>
          </Border>
          <TextBlock Text="{Binding MaintSectionTitle}" FontSize="{DynamicResource FontSizeBody}"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="维护操作保持原有范围，执行状态会显示在当前页面。" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
        <Border Style="{DynamicResource SettingsGroup}" Margin="0,0,0,16">
          <StackPanel>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><DockPanel><Button x:Name="BtnDefender" Content="{Binding DefenderText}" Click="OnDefender" Style="{DynamicResource GhostButton}" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="打开 Defender 排除说明"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DefenderTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding DefenderDesc}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}" BorderThickness="0,0,0,1"><DockPanel><Button x:Name="BtnAddon" Content="{Binding AddonText}" Click="OnAddon" Style="{DynamicResource GhostButton}" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="打开英雄联盟附加层说明"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding AddonTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding AddonDesc}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            <Border Style="{DynamicResource PolicyRow}"><DockPanel><Button x:Name="BtnShader" Content="{Binding ShaderText}" Click="OnShader" Padding="10,5" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="清理着色器缓存"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Style.Triggers><DataTrigger Binding="{Binding IsShaderBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ShaderTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><ProgressBar Width="72" Height="3" IsIndeterminate="True" Margin="0,0,8,0"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsShaderBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock x:Name="LblShaderStatus" Text="{Binding ShaderStatus}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.Name="着色器缓存状态"/></StackPanel></StackPanel></DockPanel></Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ZoneDanger">
        <TextBlock Text="危险区" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,3"/>
        <TextBlock Text="操作前会再次确认，并尝试恢复所有已记录项。" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
        <Border Style="{DynamicResource SettingsGroup}"><Border Style="{DynamicResource PolicyRow}"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><ProgressBar Width="72" Height="3" IsIndeterminate="True" Margin="0,0,10,0"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRestoreBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><Button x:Name="BtnRestore" Content="{Binding RestoreText}" Click="OnRestore" Padding="12,6" AutomationProperties.Name="恢复所有已记录的系统项"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DangerButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRestoreBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding RestoreTitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding RestoreDesc}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></Border></Border>
      </StackPanel>

      <TextBlock Text="{Binding AboutText}" FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,12,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
