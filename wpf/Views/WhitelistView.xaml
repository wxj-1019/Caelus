<UserControl x:Class="CaelusApp.WpfHost.Views.WhitelistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave"
             AutomationProperties.Name="白名单">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel x:Name="ZoneHeader" Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{Binding PageTitle}" Style="{DynamicResource PageHeader}"/>
      <TextBlock Text="{Binding PageSub}" Style="{DynamicResource PageSubtitle}" Margin="0,4,0,0"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" x:Name="ZoneLeft" Style="{DynamicResource SettingsGroup}" Padding="0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="16,14,16,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="用户规则" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="你添加的规则，可调整保护范围或删除" Margin="0,3,0,0" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
            <TextBlock Grid.Column="1" Text="右键或检查器管理" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}"/>
          </Grid>
          <Grid Grid.Row="1">
            <ContentControl x:Name="EmptyPanel" Style="{DynamicResource DropZoneEmpty}" Margin="12" Visibility="Collapsed">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Margin="24">
                <TextBlock Text="{Binding EmptyTitle}" FontSize="{DynamicResource FontSizeEmpty}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="{Binding EmptyHint}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,18"/>
                <Button Style="{DynamicResource PrimaryButton}" Click="OnPickClick" Content="{Binding PickText}" HorizontalAlignment="Center" AutomationProperties.Name="从运行中的程序添加白名单规则"/>
                <Button Style="{DynamicResource GhostButton}" Click="OnBrowseClick" Content="{Binding BrowseText}" HorizontalAlignment="Center" Margin="0,8,0,0" AutomationProperties.Name="浏览可执行文件并添加白名单规则"/>
                <TextBlock Text="{Binding DropHint}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"/>
              </StackPanel>
            </ContentControl>

            <ListBox x:Name="RuleList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" ItemContainerStyle="{DynamicResource ListItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" KeyboardNavigation.DirectionalNavigation="Continue" SelectionChanged="OnRuleSelectionChanged" PreviewKeyDown="OnRuleListPreviewKeyDown" KeyDown="OnRuleListKeyDown" PreviewMouseRightButtonDown="OnRuleListPreviewMouseRightButtonDown" AutomationProperties.Name="白名单规则" Visibility="Collapsed">
              <ListBox.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="只保护这一个（不含子进程）" Click="OnNarrowClick" IsEnabled="{Binding CanNarrow}"/><MenuItem Header="连子进程一起保护" Click="OnWidenClick" IsEnabled="{Binding CanWiden}"/><Separator/><MenuItem Header="删除规则" Click="OnRemoveClick" IsEnabled="{Binding CanRemoveSelected}"/></ContextMenu></ListBox.ContextMenu>
              <ListBox.ItemTemplate><DataTemplate><Grid>
                <Grid x:Name="GroupHeader" Margin="12,14,12,6" Visibility="Collapsed" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding GroupTitle}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/><Rectangle Grid.Column="1" Height="1" Margin="12,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource BorderSubtleBrush}"/></Grid>
                <Border x:Name="RuleRow" Style="{DynamicResource PolicyRow}" Margin="6,2" Padding="12,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Subtitle}"/></StackPanel><Border Grid.Column="1" Style="{DynamicResource NeutralStatusBadge}" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="{Binding Badge}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}"/></Border><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="72"><Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsLive}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding StateText}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
              </Grid>
              <DataTemplate.Triggers><DataTrigger Binding="{Binding IsGroupHeader}" Value="True"><Setter TargetName="GroupHeader" Property="Visibility" Value="Visible"/><Setter TargetName="RuleRow" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
            </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" x:Name="ZoneRight" Style="{DynamicResource SettingsGroup}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16">
            <TextBlock Text="添加规则" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
            <Button Style="{DynamicResource PrimaryButton}" Click="OnPickClick" Content="{Binding PickText}" HorizontalAlignment="Stretch" AutomationProperties.Name="从运行中的程序添加白名单规则"/>
            <Button Style="{DynamicResource GhostButton}" Click="OnBrowseClick" Content="{Binding BrowseText}" HorizontalAlignment="Stretch" Margin="0,6,0,0" AutomationProperties.Name="浏览可执行文件并添加白名单规则"/>
            <TextBlock Text="{Binding DropHint}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" Margin="0,16"/>
            <TextBlock Text="所选规则" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="先从左侧选择一条规则" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <StackPanel Margin="0,8,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding Selected.Title}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="路径或规则值" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,3"/><TextBlock Text="{Binding Selected.InspectorValue}" FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" ToolTip="{Binding Selected.InspectorValue}"/><TextBlock Text="规则类型" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,3"/><TextBlock Text="{Binding Selected.RuleTypeText}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="当前匹配" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,3"/><TextBlock Text="{Binding Selected.MatchCountText}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
            <Border Padding="10,8" Margin="0,12,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource WarningStatusBanner}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Selected.Required}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Selected.LockReason}" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></Border>
            <TextBlock Text="保护范围" FontSize="{DynamicResource FontSizeXs}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,14,0,6"/>
            <Button Style="{DynamicResource GhostButton}" Click="OnNarrowClick" Content="只保护这一个（不含子进程）" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsEnabled="{Binding CanNarrow}"/>
            <Button Style="{DynamicResource GhostButton}" Click="OnWidenClick" Content="连子进程一起保护" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,4,0,0" IsEnabled="{Binding CanWiden}"/>
            <Button Style="{DynamicResource DangerButton}" Click="OnRemoveClick" Content="{Binding RemoveText}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,12,0,0" IsEnabled="{Binding CanRemoveSelected}" AutomationProperties.Name="删除所选白名单规则"/>
            <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" Margin="0,16"/>
            <Button Click="OnResetClick" Content="{Binding ResetText}" HorizontalAlignment="Stretch" Style="{DynamicResource DangerButton}" AutomationProperties.Name="将白名单重置为系统预设"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border x:Name="DropOverlay" Grid.ColumnSpan="3" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="2" CornerRadius="{DynamicResource RadiusSm}" Visibility="Collapsed" IsHitTestVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="松开以添加白名单规则" FontSize="{DynamicResource FontSizeEmpty}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="支持 .exe 或快捷方式" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/></StackPanel></Border>
    </Grid>
  </Grid>
</UserControl>
