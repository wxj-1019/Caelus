<UserControl x:Class="CaelusApp.WpfHost.Views.WhitelistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <!-- 页头（规格 §7 5a） -->
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <TextBlock Text="白名单" Style="{DynamicResource SectionTitle}"/>
      <TextBlock Text="永不触碰的进程" Style="{DynamicResource SectionSubtitle}" Margin="0,3,0,0"/>
    </StackPanel>

    <!-- 左：列表区 / 空态 -->
    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
      <!-- 空态 -->
      <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding EmptyTitle}" FontSize="{DynamicResource FontSizeDisplay}"
                   FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding EmptyHint}" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="400"/>
      </StackPanel>

      <!-- 列表 -->
      <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,6">
                <!-- 分组标题（IsGroupHeader=true 时显示） -->
                <TextBlock Text="{Binding GroupTitle}" FontSize="11"
                           FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="6,10,0,6" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <!-- 普通条目（IsGroupHeader=false 时显示） -->
                <Border MouseLeftButtonDown="OnItemClick">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource LibraryItemCard}">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <DockPanel>
                    <!-- 右：状态点 + 文案 -->
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                      <DockPanel>
                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,6,0"
                                 VerticalAlignment="Center">
                          <Ellipse.Style>
                            <Style TargetType="Ellipse">
                              <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                  <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StateText}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                      </DockPanel>
                    </StackPanel>

                    <!-- 右-2：徽标 -->
                    <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                            CornerRadius="{DynamicResource RadiusSm}" Padding="8,3" Margin="0,0,10,0"
                            Background="{DynamicResource GlassNavBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                      <TextBlock Text="{Binding Badge}" FontSize="10"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>

                    <!-- 中：标题 + 路径 -->
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeCaption}"
                                 FontWeight="Bold" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Required}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                 Foreground="{DynamicResource TextTertiaryBrush}"
                                 TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- 右：操作按钮 -->
    <StackPanel Grid.Row="1" Grid.Column="1">
      <Button Style="{DynamicResource PrimaryButton}" Click="OnPickClick"
              Content="{Binding PickText}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
      <Button Style="{DynamicResource PrimaryButton}" Click="OnBrowseClick"
              Content="{Binding BrowseText}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
              Opacity="0.85"/>
      <Button Style="{DynamicResource GhostButton}" Click="OnRemoveClick"
              Content="{Binding RemoveText}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
              IsEnabled="{Binding CanRemoveSelected}"/>
      <Button Style="{DynamicResource GhostButton}" Click="OnNarrowClick"
              Content="缩窄范围" HorizontalAlignment="Stretch" Margin="0,0,0,8"
              IsEnabled="{Binding CanNarrow}"/>
      <Button Style="{DynamicResource GhostButton}" Click="OnWidenClick"
              Content="扩展为家族" HorizontalAlignment="Stretch" Margin="0,0,0,8"
              IsEnabled="{Binding CanWiden}"/>
      <TextBlock Text="{Binding DropHint}" FontSize="11"
                 Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"
                 Margin="4,8,4,0"/>

      <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" Margin="0,16,0,16"/>

      <Button Click="OnResetClick" Content="{Binding ResetText}"
              HorizontalAlignment="Stretch">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
          </Style>
        </Button.Style>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
